<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="Form_Work" width="1280" height="720" titletext="Form_Work">
    <Layouts>
      <Layout width="1280" height="720" screenid="Desktop_screen">
        <Button id="btn_search" taborder="0" text="조회" left="20" top="70" width="120" height="50" onclick="fn_search"/>
        <Grid id="grd_codeType" taborder="1" left="20" top="135" width="480" height="565" binddataset="ds_codeType" autofittype="col">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="80"/>
                <Column size="80"/>
                <Column size="80"/>
                <Column size="80"/>
              </Columns>
              <Rows>
                <Row size="24" band="head"/>
                <Row size="24"/>
              </Rows>
              <Band id="head">
                <Cell text="CODE_TYPE"/>
                <Cell col="1" text="CODE_TYPE_NM"/>
                <Cell col="2" text="START_DATE"/>
                <Cell col="3" text="END_DATE"/>
              </Band>
              <Band id="body">
                <Cell text="bind:CODE_TYPE"/>
                <Cell col="1" text="bind:CODE_TYPE_NM"/>
                <Cell col="2" text="bind:START_DATE" calendardateformat="yyyy-MM-dd"/>
                <Cell col="3" text="bind:END_DATE" calendardateformat="yyyy-MM-dd"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[this.fn_search = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.ds_search.clearData();
	var nRow = this.ds_search.addRow();
	this.ds_search.setColumn(nRow, "CODE_TYPE"   , "CREATE_TYPE_CD");
	this.ds_search.setColumn(nRow, "CODE_TYPE_NM", "생성");
	
	var sSvcID 			= "selectCodeList";
	var sURL 			= "http://localhost:8080/nbdf/com/COM10000M/selectCodeList.do";
	var sInDatasets 	= "inSearch=ds_search";
	var sOutDatasets 	= "ds_codeType=outSelectCodeTypeList";
	var sArgument 		= "userId=" + "admin";
	var sCallbackFunc 	= "fn_callback";
	
	// 공통코드 조회
	this.transaction(sSvcID, sURL, sInDatasets, sOutDatasets, sArgument, sCallbackFunc);
};

this.fn_callback = function(sSvcID, nErrCd, sErrMsg)
{
	if(nErrCd < 0) {
		alert("오류 : " + sErrMsg);
	}

	switch(sSvcID) {
		case "selectCodeList":
			trace("###########################################################");
			trace(this.ds_codeType.saveXML());
			trace("###########################################################");
			
			var nCnt = this.ds_codeType.rowcount;			
			if (nCnt == 0) {
				alert("조회조건에 일치하는 데이터가 존재하지 않습니다.");
			}
			break;
		}
};
]]></Script>
    <Objects>
      <Dataset id="ds_search">
        <ColumnInfo>
          <Column id="CODE_TYPE" type="STRING" size="256"/>
          <Column id="CODE_TYPE_NM" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_codeType">
        <ColumnInfo>
          <Column id="CODE_TYPE" type="STRING" size="256"/>
          <Column id="CODE_TYPE_NM" type="STRING" size="256"/>
          <Column id="CODE_TYPE_NM_S" type="STRING" size="256"/>
          <Column id="START_DATE" type="STRING" size="256"/>
          <Column id="END_DATE" type="STRING" size="256"/>
          <Column id="CREATE_TYPE_CD" type="STRING" size="256"/>
          <Column id="REMARK" type="STRING" size="256"/>
          <Column id="CREATE_DATE" type="STRING" size="256"/>
          <Column id="CREATE_BY" type="STRING" size="256"/>
          <Column id="UPDATE_DATE" type="STRING" size="256"/>
          <Column id="UPDATE_BY" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_code"/>
    </Objects>
  </Form>
</FDL>
