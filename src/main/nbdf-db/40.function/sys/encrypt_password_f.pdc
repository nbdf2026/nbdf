-- [시스템관리관리] 사용자 접속
conn nsys/manager!@vis12215;
-- ------------------------------------------------------------------------------------------------


-- ------------------------------------------------------------------------------------------------
-- [시스템관리관] 단방향 암호화 오브젝트 생성
-- ------------------------------------------------------------------------------------------------
drop function nsys.encrypt_password_f;
create function nsys.encrypt_password_f(p_value varchar2)
return varchar2
is
    v_hash varchar2(128);
begin
    select standard_hash(p_value, 'SHA256')
      into v_hash
      from dual;
      
    return v_hash;
end;
/

-- 권한 부여
grant execute on ncom.encrypt_password_f to nsys;
grant execute on ncom.encrypt_password_f to nhrm;

-- 시노님 생성
create or replace synonym ncom.encrypt_password_f for nsys.encrypt_password_f;
create or replace synonym nhrm.encrypt_password_f for nsys.encrypt_password_f;
