-- ------------------------------------------------------------------------------------------------
-- [시스템관리관리] 사용자 접속
conn nsys/manager!@vis12215;
-- ------------------------------------------------------------------------------------------------


-- ------------------------------------------------------------------------------------------------
-- [시스템관리관] 복호화 오브젝트 생성
-- ------------------------------------------------------------------------------------------------
drop function nsys.decrypt_f;
create function nsys.decrypt_f(p_value varchar2)
return varchar2
is
    l_key raw(32);
    l_raw raw(32767);

    l_type pls_integer :=
          dbms_crypto.encrypt_aes256
        + dbms_crypto.chain_cbc
        + dbms_crypto.pad_pkcs5;
begin
    l_key := utl_i18n.string_to_raw
             ('12345678901234567890123456789012'
             ,'AL32UTF8'
             );

    l_raw := dbms_crypto.decrypt
             (src => hextoraw(p_value)
             ,typ => l_type
             ,key => l_key
             );

    return utl_i18n.raw_to_char(l_raw, 'AL32UTF8');
end;
/

-- 권한 부여
grant execute on ncom.decrypt_f to nsys;
grant execute on ncom.decrypt_f to nhrm;

-- 시노님 생성
create or replace synonym ncom.decrypt_f for nsys.decrypt_f;
create or replace synonym nhrm.decrypt_f for nsys.decrypt_f;
