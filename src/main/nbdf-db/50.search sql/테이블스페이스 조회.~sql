-- 테이블스페이스 조회
SELECT DF.STATUS    AS "상태"
      ,DF.ENABLED   AS "읽기쓰기"
      ,DF.NAME      AS "파일경로"
      ,TS.NAME      AS "테이블스페이스명"
  FROM V$DATAFILE DF
       INNER JOIN V$TABLESPACE TS ON TS.TS# = DF.TS#
 WHERE 1=1
   AND TS.NAME LIKE 'XBDF%'
;

-- 데이터 파일 조회
SELECT *
  FROM DBA_DATA_FILES DDF
 WHERE 1=1
   AND DDF.TABLESPACE_NAME LIKE 'XBDF%'
;
