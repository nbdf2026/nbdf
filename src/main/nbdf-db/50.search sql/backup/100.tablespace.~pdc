SHOW USER;
SET TRIMSPOOL ON;
SET TIMING ON;
SET HEADING ON;
SET LINESIZE 205;
SET PAGESIZE 20;

-- 테이블스페이스 삭제
DROP TABLESPACE EAPEX_DATA INCLUDING CONTENTS AND DATAFILES;
DROP TABLESPACE EAPEX_IDX  INCLUDING CONTENTS AND DATAFILES;

-- 테이블스페이스 생성
CREATE TABLESPACE EAPEX_DATA DATAFILE '/d01/oradata/eapex_data.dbf' SIZE 50M REUSE AUTOEXTEND ON NEXT 10M MAXSIZE UNLIMITED;
CREATE TABLESPACE EAPEX_IDX  DATAFILE '/d01/oradata/eapex_idx.dbf'  SIZE 50M REUSE AUTOEXTEND ON NEXT 10M MAXSIZE UNLIMITED;

-- 테이블스페이스 조회
SELECT DF.STATUS    AS "상태"
      ,DF.ENABLED   AS "읽기쓰기"
      ,DF.NAME      AS "파일경로"
      ,TS.NAME      AS "테이블스페이스명"
  FROM V$DATAFILE DF
       INNER JOIN V$TABLESPACE TS ON TS.TS# = DF.TS#
 WHERE 1=1
   AND TS.NAME LIKE 'EAPX%'
;

-- 데이터 파일 조회
SELECT *
  FROM DBA_DATA_FILES DDF
 WHERE 1=1
   AND DDF.TABLESPACE_NAME LIKE 'EAPX%'
;
