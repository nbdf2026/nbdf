-- ------------------------------------------------------------------------------------------------
-- xsys 사용자 생성
-- ------------------------------------------------------------------------------------------------
drop   user xsys cascade;
create user xsys identified by "manager"
default tablespace ebdf_data
temporary tablespace temp
profile default
quota unlimited on ebdf_data
quota unlimited on ebdf_idx;

-- 롤권한
grant connect  to xsys;
grant dba      to xsys;
grant resource to xsys;

-- 시스템 권한
grant create cluster                 to xsys with admin option;
grant create dimension               to xsys with admin option;
grant create indextype               to xsys with admin option;
grant create job                     to xsys with admin option;
grant create materialized view       to xsys with admin option;
grant create operator                to xsys with admin option;
grant create procedure               to xsys with admin option;
grant create sequence                to xsys with admin option;
grant create session                 to xsys with admin option;
grant create synonym                 to xsys with admin option;
grant create table                   to xsys with admin option;
grant create trigger                 to xsys with admin option;
grant create type                    to xsys with admin option;
grant create view                    to xsys with admin option;
grant unlimited tablespace           to xsys;



