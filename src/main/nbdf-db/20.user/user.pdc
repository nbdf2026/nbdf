grant create operator                to nhrm with admin option;
grant create procedure               to nhrm with admin option;
grant create sequence                to nhrm with admin option;
grant create synonym                 to nhrm with admin option;
grant create table                   to nhrm with admin option;
grant create trigger                 to nhrm with admin option;
grant create type                    to nhrm with admin option;
grant create view                    to nhrm with admin option;
grant unlimited tablespace           to nhrm;
*/
