-- ------------------------------------------------------------------------------------------------
-- nhrm 사용자 생성
-- ------------------------------------------------------------------------------------------------
drop   user nhrm cascade;
create user nhrm identified by "manager!"
default tablespace nbdf_data
temporary tablespace temp
profile default
quota unlimited on nbdf_data
quota unlimited on nbdf_idx;

-- 롤권한
grant connect  to nhrm;
grant resource to nhrm;


select *
  from dba_users du
 where 1=1
   and du.username like 'N%'
;

/*
-- 시스템 권한
