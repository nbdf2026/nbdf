-- ------------------------------------------------------------------------------------------------
-- 테이블 생성
DROP   TABLE ECOM.COM_USER CASCADE CONSTRAINTS;
CREATE TABLE ECOM.COM_USER
(
     CORP_ID                 NUMBER
    ,ID                      NUMBER         NOT NULL
    ,USER_ID                 VARCHAR2(50)   NOT NULL
	,USER_NAME               VARCHAR2(200)  NOT NULL
    ,USER_PWD                VARCHAR2(2000) NOT NULL
    ,EMP_ID                  NUMBER
    ,EMAIL_ADDRESS           VARCHAR2(0100)
    ,START_DATE              DATE           DEFAULT TRUNC(SYSDATE) NOT NULL
    ,END_DATE                DATE
	,REMARK                  VARCHAR2(4000)
    ,CREATE_DATE             DATE           DEFAULT SYSDATE
    ,CREATE_BY               VARCHAR2(50)   DEFAULT '-1'
    ,UPDATE_DATE             DATE           DEFAULT SYSDATE
    ,UPDATE_BY               VARCHAR2(50)   DEFAULT '-1'
)
TABLESPACE EAPEX_DATA;

-- 테이블 설명
COMMENT ON TABLE  ECOM.COM_USER                   IS '[공통관리] 사용자';
COMMENT ON COLUMN ECOM.COM_USER.CORP_ID           IS '법인ID';
COMMENT ON COLUMN ECOM.COM_USER.ID                IS '사용자ID';
COMMENT ON COLUMN ECOM.COM_USER.USER_ID           IS '사용자코드';
COMMENT ON COLUMN ECOM.COM_USER.USER_NAME         IS '사용자명';
COMMENT ON COLUMN ECOM.COM_USER.USER_PWD          IS '사용자비밀번호';
COMMENT ON COLUMN ECOM.COM_USER.EMP_ID            IS '개인ID';
COMMENT ON COLUMN ECOM.COM_USER.EMAIL_ADDRESS     IS '이메일주소';
COMMENT ON COLUMN ECOM.COM_USER.START_DATE        IS '시작일자';
COMMENT ON COLUMN ECOM.COM_USER.END_DATE          IS '종료일자';
COMMENT ON COLUMN ECOM.COM_USER.REMARK            IS '비고';

COMMENT ON COLUMN ECOM.COM_USER.CREATE_DATE       IS '생성일시';
COMMENT ON COLUMN ECOM.COM_USER.CREATE_BY         IS '생성자';
COMMENT ON COLUMN ECOM.COM_USER.UPDATE_DATE       IS '수정일시';
COMMENT ON COLUMN ECOM.COM_USER.UPDATE_BY         IS '수정자';

-- PRIMARY 인덱스
ALTER TABLE ECOM.COM_USER ADD CONSTRAINT COM_USER_PK PRIMARY KEY (ID) USING INDEX TABLESPACE EAPEX_IDX;

-- UNIQUE 인덱스
CREATE UNIQUE INDEX ECOM.COM_USER_UK01 ON ECOM.COM_USER (USER_ID) TABLESPACE EAPEX_IDX;

-- NORMAL 인덱스
CREATE INDEX ECOM.COM_USER_IX01 ON ECOM.COM_USER (EMP_ID) TABLESPACE EAPEX_IDX;
CREATE INDEX ECOM.COM_USER_IX02 ON ECOM.COM_USER (USER_NAME) TABLESPACE EAPEX_IDX;

-- 권한부여
GRANT SELECT, INSERT, UPDATE, DELETE ON ECOM.COM_USER TO ESYS WITH GRANT OPTION;
GRANT SELECT, INSERT, UPDATE, DELETE ON ECOM.COM_USER TO EHRM WITH GRANT OPTION;

-- 트리거
CREATE OR REPLACE TRIGGER ECOM.COM_USER_TRG
    BEFORE INSERT OR UPDATE ON ECOM.COM_USER
    FOR EACH ROW
BEGIN
    IF INSERTING THEN
        IF :NEW.USER_PWD IS NOT NULL THEN
            IF LENGTH(:NEW.USER_PWD) <= 12 THEN
                :NEW.USER_PWD := SYS_CRYPTO_API.ENCRYPT_F(:NEW.USER_PWD);
            END IF;
        ELSE
            APEX_DEBUG.MESSAGE('신규 패스워드 => ' || :NEW.USER_PWD, P_LEVEL => 3);
            RAISE_APPLICATION_ERROR(-20001, '비밀번호는 필수 항목입니다.');
        END IF;

        :NEW.CREATE_DATE := SYSDATE;
        :NEW.CREATE_BY   := NVL(WWV_FLOW.G_USER, USER);

    ELSIF UPDATING THEN
        IF :NEW.USER_PWD IS NOT NULL AND :NEW.USER_PWD != :OLD.USER_PWD AND LENGTH(:NEW.USER_PWD) <= 12 THEN
            :NEW.USER_PWD := SYS_CRYPTO_API.ENCRYPT_F(:NEW.USER_PWD);
        ELSIF :NEW.USER_PWD IS NULL THEN
            :NEW.USER_PWD := :OLD.USER_PWD;
        END IF;

    END IF;

    :NEW.UPDATE_DATE := SYSDATE;
    :NEW.UPDATE_BY   := NVL(WWV_FLOW.G_USER, USER);
END;



/

-- 시노님 생성
CREATE OR REPLACE SYNONYM ESYS.COM_USER FOR ECOM.COM_USER;
CREATE OR REPLACE SYNONYM EHRM.COM_USER FOR ECOM.COM_USER;



