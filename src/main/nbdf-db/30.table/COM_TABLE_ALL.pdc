CONN SYSTEM/MANAGER@DEV1213;
-- SYS_CRYPTO_API.ENCRYPT_F 함수 사용으로 오류 발생: 패키지 생성 후 트리거 재생성(ECOM.COM_USER_TRG)

-- ------------------------------------------------------------------------------------------------
-- [ 공통관리] 코드유형 테이블 생성
CONN SYSTEM/MANAGER@DEV1213;
-- ------------------------------------------------------------------------------------------------
-- 테이블 생성
DROP   TABLE ECOM.COM_CODE_TYPE CASCADE CONSTRAINTS;
CREATE TABLE ECOM.COM_CODE_TYPE
(
     CORP_ID                 NUMBER
    ,CODE_TYPE_ID            NUMBER         NOT NULL
    ,CODE_TYPE_CD            VARCHAR2(50)   NOT NULL
    ,CODE_TYPE_NAME          VARCHAR2(200)  NOT NULL
    ,CODE_TYPE_SHORT_NAME    VARCHAR2(100)
    ,START_DATE              DATE           DEFAULT TRUNC(SYSDATE) NOT NULL
    ,END_DATE                DATE
    ,REMARK                  VARCHAR2(4000)
    ,CREATE_DATE             DATE           DEFAULT SYSDATE
    ,CREATE_BY               VARCHAR2(50)   DEFAULT '-1'
    ,UPDATE_DATE             DATE           DEFAULT SYSDATE
    ,UPDATE_BY               VARCHAR2(50)   DEFAULT '-1'
)
TABLESPACE EAPEX_DATA;

-- 테이블 설명
COMMENT ON TABLE  ECOM.COM_CODE_TYPE                         IS '[공통관리] 코드유형';
COMMENT ON COLUMN ECOM.COM_CODE_TYPE.CORP_ID                 IS '법인ID';
COMMENT ON COLUMN ECOM.COM_CODE_TYPE.CODE_TYPE_ID            IS '코드유형ID';
COMMENT ON COLUMN ECOM.COM_CODE_TYPE.CODE_TYPE_CD            IS '코드유형';
COMMENT ON COLUMN ECOM.COM_CODE_TYPE.CODE_TYPE_NAME          IS '코드유형명';
COMMENT ON COLUMN ECOM.COM_CODE_TYPE.CODE_TYPE_SHORT_NAME    IS '코드유형명(약칭)';
COMMENT ON COLUMN ECOM.COM_CODE_TYPE.START_DATE              IS '시작일자';
COMMENT ON COLUMN ECOM.COM_CODE_TYPE.END_DATE                IS '종료일자';
COMMENT ON COLUMN ECOM.COM_CODE_TYPE.REMARK                  IS '비고';

COMMENT ON COLUMN ECOM.COM_CODE_TYPE.CREATE_DATE             IS '생성일시';
COMMENT ON COLUMN ECOM.COM_CODE_TYPE.CREATE_BY               IS '생성자';
COMMENT ON COLUMN ECOM.COM_CODE_TYPE.UPDATE_DATE             IS '수정일시';
COMMENT ON COLUMN ECOM.COM_CODE_TYPE.UPDATE_BY               IS '수정자';

-- PRIMARY 인덱스
ALTER TABLE ECOM.COM_CODE_TYPE ADD CONSTRAINT COM_CODE_TYPE_PK PRIMARY KEY (CODE_TYPE_ID) USING INDEX TABLESPACE EAPEX_IDX;

-- UNIQUE 인덱스
CREATE UNIQUE INDEX ECOM.COM_CODE_TYPE_UK ON ECOM.COM_CODE_TYPE (CORP_ID, CODE_TYPE_CD) TABLESPACE EAPEX_IDX;

-- NORMAL 인덱스
CREATE INDEX ECOM.COM_CODE_TYPE_IX01 ON ECOM.COM_CODE_TYPE (CODE_TYPE_NAME) TABLESPACE EAPEX_IDX;

-- 권한부여
GRANT SELECT, INSERT, UPDATE, DELETE ON ECOM.COM_CODE_TYPE TO ESYS WITH GRANT OPTION;
GRANT SELECT, INSERT, UPDATE, DELETE ON ECOM.COM_CODE_TYPE TO EHRM WITH GRANT OPTION;

-- 트리거
CREATE OR REPLACE TRIGGER ECOM.COM_CODE_TYPE_TRG
    BEFORE INSERT OR UPDATE OR DELETE ON ECOM.COM_CODE_TYPE
    FOR EACH ROW
DECLARE
    V_CNT    NUMBER DEFAULT 0;
BEGIN
    
    IF INSERTING OR UPDATING THEN
        IF :NEW.CODE_TYPE_ID IS NULL THEN
            :NEW.CODE_TYPE_ID := COM_CODE_TYPE_S.NEXTVAL;
        END IF;
        
        IF INSERTING THEN
            :NEW.CREATE_DATE := SYSDATE;
            :NEW.CREATE_BY   := NVL(WWV_FLOW.G_USER, USER);
        END IF;
        
        :NEW.UPDATE_DATE := SYSDATE;
        :NEW.UPDATE_BY   := NVL(WWV_FLOW.G_USER, USER);
    END IF;
    
    IF DELETING THEN
        BEGIN
            SELECT COUNT(1)
              INTO V_CNT
              FROM ECOM.COM_CODE CC
             WHERE 1=1
               AND CC.CODE_TYPE_ID = :OLD.CODE_TYPE_ID;
        EXCEPTION
            WHEN OTHERS THEN
                V_CNT := 0;
        END;
        
        IF V_CNT > 0 THEN
            RAISE_APPLICATION_ERROR('-20010', TO_CHAR(V_CNT, 'FM999,999,999,999') || '건의 상세코드가 존재합니다.');
        END IF;
    END IF;
END;
/

-- 시노님 생성
CREATE OR REPLACE SYNONYM ESYS.COM_CODE_TYPE FOR ECOM.COM_CODE_TYPE;
CREATE OR REPLACE SYNONYM EHRM.COM_CODE_TYPE FOR ECOM.COM_CODE_TYPE;



