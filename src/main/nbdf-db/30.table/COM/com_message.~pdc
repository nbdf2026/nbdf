-- ------------------------------------------------------------------------------------------------
-- [공통관리] 메시지 오브젝트 생성
conn system/manager!@orcl;
-- ------------------------------------------------------------------------------------------------

-- ------------------------------------------------------------------------------------------------
-- 시퀀스 생성
-- ------------------------------------------------------------------------------------------------
drop   sequence ncom.com_message_s;
create sequence ncom.com_message_s
minvalue 1
maxvalue 999999999999
start with 1000000
increment by 1
order;

-- 권한 부여
grant select on ncom.com_message_s to nsys;
grant select on ncom.com_message_s to nhrm;

-- 시노님 생성
create or replace synonym nsys.com_message_s for ncom.com_message_s;
create or replace synonym nhrm.com_message_s for ncom.com_message_s;


-- ------------------------------------------------------------------------------------------------
-- 테이블 생성
-- ------------------------------------------------------------------------------------------------
drop   table ncom.com_message cascade constraints;
create table ncom.com_message
(
     message_num             varchar2(30)   not null
    ,message_type_cd         varchar2(30)   not null
    ,message_text_ko         varchar2(300)  not null
    ,message_text_en         varchar2(300)  not null
    ,message_text_zh         varchar2(300)  not null
    ,message_text_ja         varchar2(300)  not null
    ,message_text_ot         varchar2(300)  not null
    ,button_yes              varchar2(30)
    ,button_no               varchar2(30)
    ,button_cancle           varchar2(30)
    ,remark                  varchar2(4000)
    ,create_date             date           default sysdate
    ,create_by               varchar2(50)   default 'admin'
    ,update_date             date           default sysdate
    ,update_by               varchar2(50)   default 'admin'
) tablespace nbdf_data;

-- 테이블 설명
comment on table  ncom.com_message                  is '[공통관리] 메시지';
comment on column ncom.com_message.message_num      is '메시지번호';
comment on column ncom.com_message.message_type_cd  is '메시지유형코드';
comment on column ncom.com_message.message_text_ko  is '메시지(국어)';
comment on column ncom.com_message.message_text_en  is '메시지(영어)';
comment on column ncom.com_message.message_text_zh  is '메시지(중국어)';
comment on column ncom.com_message.message_text_ja  is '메시지(일본어)';
comment on column ncom.com_message.message_text_ot  is '메시지(기타)';
comment on column ncom.com_message.button_yes       is '버튼(예)';
comment on column ncom.com_message.button_no        is '버튼(아니오)';
comment on column ncom.com_message.button_cancle    is '버튼(취소)';
comment on column ncom.com_message.remark           is '비고';

comment on column ncom.com_message.create_date      is '생성일시';
comment on column ncom.com_message.create_by        is '생성자';
comment on column ncom.com_message.update_date      is '수정일시';
comment on column ncom.com_message.update_by        is '수정자';

-- primary 인덱스
alter table ncom.com_message add constraint com_message_pk primary key (message_num) using index tablespace nbdf_idx;

-- unique 인덱스
create unique index ncom.com_message_uk01 on ncom.com_message (message_type_cd, message_text_ko) tablespace nbdf_idx;

-- normal 인덱스
create index ncom.com_message_ix01 on ncom.com_message (message_type_cd, message_text_en) tablespace nbdf_idx;

-- 권한부여
grant all on ncom.com_message to nsys;
grant all on ncom.com_message to nhrm;

-- 시노님 생성
create or replace synonym nsys.com_message for ncom.com_message;
create or replace synonym nhrm.com_message for ncom.com_message;
