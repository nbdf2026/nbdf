-- ------------------------------------------------------------------------------------------------
-- [공통관리] 프로젝트구성원 오브젝트 생성
CONN SYSTEM/MANAGER@DEV1213;
-- ------------------------------------------------------------------------------------------------

-- ------------------------------------------------------------------------------------------------
-- 시퀀스 생성
-- ------------------------------------------------------------------------------------------------
DROP   SEQUENCE ECOM.COM_PROJECT_MEMBER_S;
CREATE SEQUENCE ECOM.COM_PROJECT_MEMBER_S
MINVALUE 1
MAXVALUE 999999999999
START WITH 1000000
INCREMENT BY 1
ORDER;

-- 권한 부여
GRANT SELECT ON ECOM.COM_PROJECT_MEMBER_S TO ESYS WITH GRANT OPTION;
GRANT SELECT ON ECOM.COM_PROJECT_MEMBER_S TO EHRM WITH GRANT OPTION;

-- 시노님 생성
CREATE OR REPLACE SYNONYM ESYS.COM_PROJECT_MEMBER_S FOR ECOM.COM_PROJECT_MEMBER_S;
CREATE OR REPLACE SYNONYM EHRM.COM_PROJECT_MEMBER_S FOR ECOM.COM_PROJECT_MEMBER_S;


-- ------------------------------------------------------------------------------------------------
-- 테이블 생성
-- ------------------------------------------------------------------------------------------------
DROP   TABLE ECOM.COM_PROJECT_MEMBER CASCADE CONSTRAINTS;
CREATE TABLE ECOM.COM_PROJECT_MEMBER
(
     CORP_ID                     NUMBER         NOT NULL
    ,PROJECT_MEMBER_ID           NUMBER         NOT NULL
    ,PROJECT_ID                  NUMBER         NOT NULL
    ,PROJECT_ITEM_CD             VARCHAR2(30)   NOT NULL
    ,OUTSOURCING_YN              VARCHAR2(1)    DEFAULT 'N' NOT NULL
    ,START_DATE                  DATE
    ,END_DATE                    DATE
    ,EMP_ID                      NUMBER
    ,ROLE_NAME                   VARCHAR2(500)
    ,CHARGE_MEMDAY               NUMBER         DEFAULT 0
    ,UNIT_PRICE                  NUMBER         DEFAULT 0
    ,CHARGE_AMOUNT               NUMBER         DEFAULT 0
    ,VENDOR_ID                   NUMBER
    ,VENDOR_PERSON_NAME          VARCHAR2(100)
    ,VENDOR_PERSON_UNIT_PRICE    NUMBER         DEFAULT 0
    ,VENDOR_PERSON_TOTAL_AMOUNT  NUMBER         DEFAULT 0
    ,REMARK                      VARCHAR2(4000)
    ,CREATE_DATE                 DATE           DEFAULT SYSDATE
    ,CREATE_BY                   VARCHAR2(50)   DEFAULT '-1'
    ,UPDATE_DATE                 DATE           DEFAULT SYSDATE
    ,UPDATE_BY                   VARCHAR2(50)   DEFAULT '-1'
) TABLESPACE EAPEX_DATA;

-- 테이블 설명
COMMENT ON TABLE  ECOM.COM_PROJECT_MEMBER                               IS '[공통관리] 프로젝트구성원';
COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.CORP_ID                       IS '법인ID';
COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.PROJECT_MEMBER_ID             IS '프로젝트구성원ID';
COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.PROJECT_ID                    IS '프로젝트ID';
COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.PROJECT_ITEM_CD               IS '프로젝트항목코드';
COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.OUTSOURCING_YN                IS '외주여부';
COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.START_DATE                    IS '시작일자';
COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.END_DATE                      IS '종료일자';
COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.EMP_ID                        IS '임직원ID';
COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.ROLE_NAME                     IS '담당업무';
COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.CHARGE_MEMDAY                 IS '투입공수';
COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.UNIT_PRICE                    IS '단가';
COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.CHARGE_AMOUNT                 IS '총금액';
COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.VENDOR_ID                     IS '공급업체ID';
COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.VENDOR_PERSON_NAME            IS '외주성명';
COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.VENDOR_PERSON_UNIT_PRICE      IS '외주단가';
COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.VENDOR_PERSON_TOTAL_AMOUNT    IS '외주총금액';
COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.REMARK                        IS '비고';

COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.CREATE_DATE                   IS '생성일시';
COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.CREATE_BY                     IS '생성자';
COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.UPDATE_DATE                   IS '수정일시';
COMMENT ON COLUMN ECOM.COM_PROJECT_MEMBER.UPDATE_BY                     IS '수정자';

-- PRIMARY 인덱스
ALTER TABLE ECOM.COM_PROJECT_MEMBER ADD CONSTRAINT COM_PROJECT_MEMBER_PK PRIMARY KEY (PROJECT_MEMBER_ID) USING INDEX TABLESPACE EAPEX_IDX;

-- UNIQUE 인덱스
CREATE UNIQUE INDEX ECOM.COM_PROJECT_MEMBER_UK01 ON ECOM.COM_PROJECT_MEMBER (CORP_ID, PROJECT_ID, PROJECT_MEMBER_ID) TABLESPACE EAPEX_IDX;

-- NORMAL 인덱스
CREATE INDEX ECOM.COM_PROJECT_MEMBER_IX01 ON ECOM.COM_PROJECT_MEMBER (CORP_ID, EMP_ID) TABLESPACE EAPEX_IDX;

-- 권한부여
GRANT SELECT, INSERT, UPDATE, DELETE ON ECOM.COM_PROJECT_MEMBER TO ESYS WITH GRANT OPTION;
GRANT SELECT, INSERT, UPDATE, DELETE ON ECOM.COM_PROJECT_MEMBER TO EHRM WITH GRANT OPTION;

-- 시노님 생성
CREATE OR REPLACE SYNONYM ESYS.COM_PROJECT_MEMBER FOR ECOM.COM_PROJECT_MEMBER;
CREATE OR REPLACE SYNONYM EHRM.COM_PROJECT_MEMBER FOR ECOM.COM_PROJECT_MEMBER;
