-- ------------------------------------------------------------------------------------------------
-- [공통관리] 프로젝트 오브젝트 생성
CONN SYSTEM/MANAGER@DEV1213;
-- ------------------------------------------------------------------------------------------------

-- ------------------------------------------------------------------------------------------------
-- 시퀀스 생성
-- ------------------------------------------------------------------------------------------------
DROP   SEQUENCE ECOM.COM_PROJECT_S;
CREATE SEQUENCE ECOM.COM_PROJECT_S
MINVALUE 1
MAXVALUE 999999999999
START WITH 1000000
INCREMENT BY 1
ORDER;

-- 권한 부여
GRANT SELECT ON ECOM.COM_PROJECT_S TO ESYS WITH GRANT OPTION;
GRANT SELECT ON ECOM.COM_PROJECT_S TO EHRM WITH GRANT OPTION;

-- 시노님 생성
CREATE OR REPLACE SYNONYM ESYS.COM_PROJECT_S FOR ECOM.COM_PROJECT_S;
CREATE OR REPLACE SYNONYM EHRM.COM_PROJECT_S FOR ECOM.COM_PROJECT_S;


-- ------------------------------------------------------------------------------------------------
-- 테이블 생성
-- ------------------------------------------------------------------------------------------------
DROP   TABLE ECOM.COM_PROJECT CASCADE CONSTRAINTS;
CREATE TABLE ECOM.COM_PROJECT
(
     CORP_ID                 NUMBER         NOT NULL
    ,PROJECT_ID              NUMBER         NOT NULL
    ,PROJECT_CD              VARCHAR2(30)   NOT NULL
    ,PROJECT_NAME            VARCHAR2(200)  NOT NULL    
    ,PROJECT_SHORT_NAME      VARCHAR2(100)  NOT NULL
    ,PROJECT_TYPE_CD         VARCHAR2(30)   NOT NULL
    ,PM_EMP_ID               NUMBER         NOT NULL
    ,START_DATE              DATE           DEFAULT SYSDATE NOT NULL    
    ,END_DATE                DATE
    ,PROJECT_STATUS_CD       VARCHAR2(30)   NOT NULL
    ,TOTAL_MENDAY            NUMBER         DEFAULT 0
    ,TOTAL_AMOUNT            NUMBER         DEFAULT 0
    ,SM_YN                   VARCHAR2(1)    DEFAULT 'N'
    ,SM_CONTRACT_HOUR        NUMBER         DEFAULT 0
    ,SM_SUPPORT_HOUR         NUMBER         DEFAULT 0
    ,SM_UNIT_PRICE           NUMBER         DEFAULT 0
    ,SM_TOTAL_PRICE          NUMBER         DEFAULT 0
    ,VENDOR_ID               NUMBER
    ,CUSTOMER_ID             NUMBER
    ,REMARK                  VARCHAR2(4000)
    ,CREATE_DATE             DATE           DEFAULT SYSDATE
    ,CREATE_BY               VARCHAR2(50)   DEFAULT '-1'
    ,UPDATE_DATE             DATE           DEFAULT SYSDATE
    ,UPDATE_BY               VARCHAR2(50)   DEFAULT '-1'
) TABLESPACE EAPEX_DATA;

-- 테이블 설명
COMMENT ON TABLE  ECOM.COM_PROJECT                       IS '[공통관리] 프로젝트';
COMMENT ON COLUMN ECOM.COM_PROJECT.CORP_ID               IS '법인ID';
COMMENT ON COLUMN ECOM.COM_PROJECT.PROJECT_ID            IS '프로젝트ID';
COMMENT ON COLUMN ECOM.COM_PROJECT.PROJECT_CD            IS '프로젝트코드';
COMMENT ON COLUMN ECOM.COM_PROJECT.PROJECT_NAME          IS '프로젝트명';
COMMENT ON COLUMN ECOM.COM_PROJECT.PROJECT_SHORT_NAME    IS '프로젝트명(약칭)';
COMMENT ON COLUMN ECOM.COM_PROJECT.PROJECT_TYPE_CD       IS '프로젝트유형코드';
COMMENT ON COLUMN ECOM.COM_PROJECT.PM_EMP_ID             IS 'PM임직원ID';
COMMENT ON COLUMN ECOM.COM_PROJECT.START_DATE            IS '시작일자';
COMMENT ON COLUMN ECOM.COM_PROJECT.END_DATE              IS '종료일자';
COMMENT ON COLUMN ECOM.COM_PROJECT.PROJECT_STATUS_CD     IS '프로젝트상태코드';
COMMENT ON COLUMN ECOM.COM_PROJECT.TOTAL_MENDAY          IS '총투입공수';
COMMENT ON COLUMN ECOM.COM_PROJECT.TOTAL_AMOUNT          IS '총계약금액';
COMMENT ON COLUMN ECOM.COM_PROJECT.SM_YN                 IS 'SM여부';
COMMENT ON COLUMN ECOM.COM_PROJECT.SM_CONTRACT_HOUR      IS '계약시간';
COMMENT ON COLUMN ECOM.COM_PROJECT.SM_SUPPORT_HOUR       IS '지원시간';
COMMENT ON COLUMN ECOM.COM_PROJECT.SM_UNIT_PRICE         IS '시간단가';
COMMENT ON COLUMN ECOM.COM_PROJECT.SM_TOTAL_PRICE        IS 'SM금액';
COMMENT ON COLUMN ECOM.COM_PROJECT.VENDOR_ID             IS '공급업체ID';
COMMENT ON COLUMN ECOM.COM_PROJECT.CUSTOMER_ID           IS '고객사ID';
COMMENT ON COLUMN ECOM.COM_PROJECT.REMARK                IS '비고';

COMMENT ON COLUMN ECOM.COM_PROJECT.CREATE_DATE           IS '생성일시';
COMMENT ON COLUMN ECOM.COM_PROJECT.CREATE_BY             IS '생성자';
COMMENT ON COLUMN ECOM.COM_PROJECT.UPDATE_DATE           IS '수정일시';
COMMENT ON COLUMN ECOM.COM_PROJECT.UPDATE_BY             IS '수정자';

-- PRIMARY 인덱스
ALTER TABLE ECOM.COM_PROJECT ADD CONSTRAINT COM_PROJECT_PK PRIMARY KEY (PROJECT_ID) USING INDEX TABLESPACE EAPEX_IDX;

-- UNIQUE 인덱스
CREATE UNIQUE INDEX ECOM.COM_PROJECT_UK01 ON ECOM.COM_PROJECT (CORP_ID, PROJECT_CD) TABLESPACE EAPEX_IDX;

-- NORMAL 인덱스
CREATE INDEX ECOM.COM_PROJECT_IX01 ON ECOM.COM_PROJECT (CORP_ID, PROJECT_NAME) TABLESPACE EAPEX_IDX;
CREATE INDEX ECOM.COM_PROJECT_IX02 ON ECOM.COM_PROJECT (VENDOR_ID) TABLESPACE EAPEX_IDX;
CREATE INDEX ECOM.COM_PROJECT_IX03 ON ECOM.COM_PROJECT (CUSTOMER_ID) TABLESPACE EAPEX_IDX;

-- 권한부여
GRANT SELECT, INSERT, UPDATE, DELETE ON ECOM.COM_PROJECT TO ESYS WITH GRANT OPTION;
GRANT SELECT, INSERT, UPDATE, DELETE ON ECOM.COM_PROJECT TO EHRM WITH GRANT OPTION;

-- 시노님 생성
CREATE OR REPLACE SYNONYM ESYS.COM_PROJECT FOR ECOM.COM_PROJECT;
CREATE OR REPLACE SYNONYM EHRM.COM_PROJECT FOR ECOM.COM_PROJECT;
