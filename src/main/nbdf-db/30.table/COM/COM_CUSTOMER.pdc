-- ------------------------------------------------------------------------------------------------
-- [공통관리] 고객정보 오브젝트 생성
CONN SYSTEM/MANAGER@DEV1213;
-- ------------------------------------------------------------------------------------------------

-- ------------------------------------------------------------------------------------------------
-- 시퀀스 생성
-- ------------------------------------------------------------------------------------------------
DROP   SEQUENCE ECOM.COM_CUSTOMER_S;
CREATE SEQUENCE ECOM.COM_CUSTOMER_S
MINVALUE 1
MAXVALUE 999999999999
START WITH 1000000
INCREMENT BY 1
ORDER;

-- 권한 부여
GRANT SELECT ON ECOM.COM_CUSTOMER_S TO ESYS WITH GRANT OPTION;
GRANT SELECT ON ECOM.COM_CUSTOMER_S TO EHRM WITH GRANT OPTION;

-- 시노님 생성
CREATE OR REPLACE SYNONYM ESYS.COM_CUSTOMER_S FOR ECOM.COM_CUSTOMER_S;
CREATE OR REPLACE SYNONYM EHRM.COM_CUSTOMER_S FOR ECOM.COM_CUSTOMER_S;


-- ------------------------------------------------------------------------------------------------
-- 테이블 생성
-- ------------------------------------------------------------------------------------------------
DROP   TABLE ECOM.COM_CUSTOMER CASCADE CONSTRAINTS;
CREATE TABLE ECOM.COM_CUSTOMER
(
     CORP_ID                 NUMBER         NOT NULL
    ,CUSTOMER_ID             NUMBER         NOT NULL
    ,CUSTOMER_NAME           VARCHAR2(200)  NOT NULL
    ,CUSTOMER_SHORT_NAME     VARCHAR2(100)  NOT NULL
    ,START_DATE              DATE           DEFAULT SYSDATE NOT NULL    
    ,END_DATE                DATE
    ,HP_TEL_NUM              VARCHAR2(50)
    ,OFFICE_TEL_NUM          VARCHAR2(50)
    ,EMAIL_ADDR              VARCHAR2(50)
    ,DEPT_NAME               VARCHAR2(100)
    ,POSITION_NAME           VARCHAR2(50)
    ,JOB_NAME                VARCHAR2(50)
    ,EMP_STATUS_CD           VARCHAR2(30)   
    ,REMARK                  VARCHAR2(4000)
    ,CREATE_DATE             DATE           DEFAULT SYSDATE
    ,CREATE_BY               VARCHAR2(50)   DEFAULT '-1'
    ,UPDATE_DATE             DATE           DEFAULT SYSDATE
    ,UPDATE_BY               VARCHAR2(50)   DEFAULT '-1'
) TABLESPACE EAPEX_DATA;

-- 테이블 설명
COMMENT ON TABLE  ECOM.COM_CUSTOMER                      IS '[공통관리] 고객정보';
COMMENT ON COLUMN ECOM.COM_CUSTOMER.CORP_ID              IS '법인ID';
COMMENT ON COLUMN ECOM.COM_CUSTOMER.CUSTOMER_ID          IS '고객ID';
COMMENT ON COLUMN ECOM.COM_CUSTOMER.CUSTOMER_NAME        IS '고객명';
COMMENT ON COLUMN ECOM.COM_CUSTOMER.CUSTOMER_SHORT_NAME  IS '고객명(약칭)';
COMMENT ON COLUMN ECOM.COM_CUSTOMER.START_DATE           IS '시작일자';
COMMENT ON COLUMN ECOM.COM_CUSTOMER.END_DATE             IS '종료일자';
COMMENT ON COLUMN ECOM.COM_CUSTOMER.HP_TEL_NUM           IS '휴대전화번호';
COMMENT ON COLUMN ECOM.COM_CUSTOMER.OFFICE_TEL_NUM       IS '사무실전화번호';
COMMENT ON COLUMN ECOM.COM_CUSTOMER.EMAIL_ADDR           IS '이메일';
COMMENT ON COLUMN ECOM.COM_CUSTOMER.DEPT_NAME            IS '부서';
COMMENT ON COLUMN ECOM.COM_CUSTOMER.POSITION_NAME        IS '직책';
COMMENT ON COLUMN ECOM.COM_CUSTOMER.JOB_NAME             IS '직무';
COMMENT ON COLUMN ECOM.COM_CUSTOMER.EMP_STATUS_CD        IS '임직원상태';
COMMENT ON COLUMN ECOM.COM_CUSTOMER.REMARK               IS '비고';

COMMENT ON COLUMN ECOM.COM_CUSTOMER.CREATE_DATE          IS '생성일시';
COMMENT ON COLUMN ECOM.COM_CUSTOMER.CREATE_BY            IS '생성자';
COMMENT ON COLUMN ECOM.COM_CUSTOMER.UPDATE_DATE          IS '수정일시';
COMMENT ON COLUMN ECOM.COM_CUSTOMER.UPDATE_BY            IS '수정자';

-- PRIMARY 인덱스
ALTER TABLE ECOM.COM_CUSTOMER ADD CONSTRAINT COM_CUSTOMER_PK PRIMARY KEY (CUSTOMER_ID) USING INDEX TABLESPACE EAPEX_IDX;

-- UNIQUE 인덱스
--CREATE UNIQUE INDEX ECOM.COM_CUSTOMER_UK01 ON ECOM.COM_CUSTOMER (CORP_ID, CUSTOMER_ID) TABLESPACE EAPEX_IDX;

-- NORMAL 인덱스
CREATE INDEX ECOM.COM_CUSTOMER_IX01 ON ECOM.COM_CUSTOMER (CORP_ID, CUSTOMER_NAME) TABLESPACE EAPEX_IDX;

-- 권한부여
GRANT SELECT, INSERT, UPDATE, DELETE ON ECOM.COM_CUSTOMER TO ESYS WITH GRANT OPTION;
GRANT SELECT, INSERT, UPDATE, DELETE ON ECOM.COM_CUSTOMER TO EHRM WITH GRANT OPTION;

-- 시노님 생성
CREATE OR REPLACE SYNONYM ESYS.COM_CUSTOMER FOR ECOM.COM_CUSTOMER;
CREATE OR REPLACE SYNONYM EHRM.COM_CUSTOMER FOR ECOM.COM_CUSTOMER;
