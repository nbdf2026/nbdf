-- ------------------------------------------------------------------------------------------------
-- [공통관리] 공급업체 오브젝트 생성
CONN SYSTEM/MANAGER@DEV1213;
-- ------------------------------------------------------------------------------------------------

-- ------------------------------------------------------------------------------------------------
-- 시퀀스 생성
-- ------------------------------------------------------------------------------------------------
DROP   SEQUENCE ECOM.COM_VENDOR_S;
CREATE SEQUENCE ECOM.COM_VENDOR_S
MINVALUE 1
MAXVALUE 999999999999
START WITH 1000000
INCREMENT BY 1
ORDER;

-- 권한 부여
GRANT SELECT ON ECOM.COM_VENDOR_S TO ESYS WITH GRANT OPTION;
GRANT SELECT ON ECOM.COM_VENDOR_S TO EHRM WITH GRANT OPTION;

-- 시노님 생성
CREATE OR REPLACE SYNONYM ESYS.COM_VENDOR_S FOR ECOM.COM_VENDOR_S;
CREATE OR REPLACE SYNONYM EHRM.COM_VENDOR_S FOR ECOM.COM_VENDOR_S;


-- ------------------------------------------------------------------------------------------------
-- 테이블 생성
-- ------------------------------------------------------------------------------------------------
DROP   TABLE ECOM.COM_VENDOR CASCADE CONSTRAINTS;
CREATE TABLE ECOM.COM_VENDOR
(
     CORP_ID                 NUMBER         NOT NULL
    ,VENDOR_ID               NUMBER         NOT NULL
    ,VENDOR_NAME             VARCHAR2(200)  NOT NULL
    ,VENDOR_SHORT_NAME       VARCHAR2(100)  NOT NULL    
    ,START_DATE              DATE           DEFAULT SYSDATE NOT NULL    
    ,END_DATE                DATE
    ,VENDOR_TYPE_CD          VARCHAR2(30)   NOT NULL
    ,VENDOR_CEO_NAME         VARCHAR2(50)
    ,VENDOR_REGI_NO          VARCHAR2(20)
    ,VENDOR_LEGAL_NO         VARCHAR2(20)
    ,VENDOR_INDUSTRY         VARCHAR2(100)
    ,VENDOR_BUSINESS         VARCHAR2(100)
    ,VENDOR_TELNO            VARCHAR2(30)
    ,VENDOR_FAXNO            VARCHAR2(30)
    ,VENDOR_POSTAL_CD        VARCHAR2(10)
    ,VENDOR_ADDR1            VARCHAR2(100)
    ,VENDOR_ADDR2            VARCHAR2(100)
    ,VENDOR_HP_URL           VARCHAR2(100)
    ,CHARGE_NAME             VARCHAR2(50)
    ,CHARGE_EMAIL            VARCHAR2(50)
    ,CHARGE_TELNO1           VARCHAR2(30)
    ,CHARGE_TELNO2           VARCHAR2(30)    
    ,REMARK                  VARCHAR2(4000)
    ,CREATE_DATE             DATE           DEFAULT SYSDATE
    ,CREATE_BY               VARCHAR2(50)   DEFAULT '-1'
    ,UPDATE_DATE             DATE           DEFAULT SYSDATE
    ,UPDATE_BY               VARCHAR2(50)   DEFAULT '-1'
) TABLESPACE EAPEX_DATA;

-- 테이블 설명
COMMENT ON TABLE  ECOM.COM_VENDOR                      IS '[공통관리] 공급업체정보';
COMMENT ON COLUMN ECOM.COM_VENDOR.CORP_ID              IS '법인ID';
COMMENT ON COLUMN ECOM.COM_VENDOR.VENDOR_ID            IS '공급업체ID';
COMMENT ON COLUMN ECOM.COM_VENDOR.VENDOR_NAME          IS '공급업체명';
COMMENT ON COLUMN ECOM.COM_VENDOR.VENDOR_SHORT_NAME    IS '공급업체명(약칭)';
COMMENT ON COLUMN ECOM.COM_VENDOR.START_DATE           IS '시작일자';
COMMENT ON COLUMN ECOM.COM_VENDOR.END_DATE             IS '종료일자';
COMMENT ON COLUMN ECOM.COM_VENDOR.VENDOR_TYPE_CD       IS '공급업체유형코드';
COMMENT ON COLUMN ECOM.COM_VENDOR.VENDOR_CEO_NAME      IS '대표자명';
COMMENT ON COLUMN ECOM.COM_VENDOR.VENDOR_REGI_NO       IS '사업자번호';
COMMENT ON COLUMN ECOM.COM_VENDOR.VENDOR_LEGAL_NO      IS '법인번호';
COMMENT ON COLUMN ECOM.COM_VENDOR.VENDOR_INDUSTRY      IS '업종';
COMMENT ON COLUMN ECOM.COM_VENDOR.VENDOR_BUSINESS      IS '업태';
COMMENT ON COLUMN ECOM.COM_VENDOR.VENDOR_TELNO         IS '전화번호';
COMMENT ON COLUMN ECOM.COM_VENDOR.VENDOR_FAXNO         IS '팩스번호';
COMMENT ON COLUMN ECOM.COM_VENDOR.VENDOR_POSTAL_CD     IS '우편번호';
COMMENT ON COLUMN ECOM.COM_VENDOR.VENDOR_ADDR1         IS '주소';
COMMENT ON COLUMN ECOM.COM_VENDOR.VENDOR_ADDR2         IS '상세주소';
COMMENT ON COLUMN ECOM.COM_VENDOR.VENDOR_HP_URL        IS '홈페이지URL';
COMMENT ON COLUMN ECOM.COM_VENDOR.CHARGE_NAME          IS '담당자성명';
COMMENT ON COLUMN ECOM.COM_VENDOR.CHARGE_EMAIL         IS '담당자이메일';
COMMENT ON COLUMN ECOM.COM_VENDOR.CHARGE_TELNO1        IS '담당자전화번호1';
COMMENT ON COLUMN ECOM.COM_VENDOR.CHARGE_TELNO2        IS '담당자전화번호2';
COMMENT ON COLUMN ECOM.COM_VENDOR.REMARK               IS '비고';

COMMENT ON COLUMN ECOM.COM_VENDOR.CREATE_DATE           IS '생성일시';
COMMENT ON COLUMN ECOM.COM_VENDOR.CREATE_BY             IS '생성자';
COMMENT ON COLUMN ECOM.COM_VENDOR.UPDATE_DATE           IS '수정일시';
COMMENT ON COLUMN ECOM.COM_VENDOR.UPDATE_BY             IS '수정자';

-- PRIMARY 인덱스
ALTER TABLE ECOM.COM_VENDOR ADD CONSTRAINT COM_VENDOR_PK PRIMARY KEY (VENDOR_ID) USING INDEX TABLESPACE EAPEX_IDX;

-- UNIQUE 인덱스
CREATE UNIQUE INDEX ECOM.COM_VENDOR_UK01 ON ECOM.COM_VENDOR (CORP_ID, VENDOR_ID) TABLESPACE EAPEX_IDX;

-- NORMAL 인덱스
CREATE INDEX ECOM.COM_VENDOR_IX01 ON ECOM.COM_VENDOR (CORP_ID, VENDOR_NAME) TABLESPACE EAPEX_IDX;

-- 권한부여
GRANT SELECT, INSERT, UPDATE, DELETE ON ECOM.COM_VENDOR TO ESYS WITH GRANT OPTION;
GRANT SELECT, INSERT, UPDATE, DELETE ON ECOM.COM_VENDOR TO EHRM WITH GRANT OPTION;

-- 시노님 생성
CREATE OR REPLACE SYNONYM ESYS.COM_VENDOR FOR ECOM.COM_VENDOR;
CREATE OR REPLACE SYNONYM EHRM.COM_VENDOR FOR ECOM.COM_VENDOR;
