-- ------------------------------------------------------------------------------------------------
-- [시스템관리] 배치프로그램-매개변수 오브젝트 생성
CONN SYSTEM/MANAGER@DEV1213;
-- ------------------------------------------------------------------------------------------------

-- ------------------------------------------------------------------------------------------------
-- 시퀀스 생성
-- ------------------------------------------------------------------------------------------------
DROP   SEQUENCE ESYS.SYS_BAT_PROGRAM_ARG_S;
CREATE SEQUENCE ESYS.SYS_BAT_PROGRAM_ARG_S
MINVALUE 1
MAXVALUE 999999999999
START WITH 1000000
INCREMENT BY 1
ORDER;

-- 권한 부여
GRANT SELECT ON ESYS.SYS_BAT_PROGRAM_ARG_S TO ESYS WITH GRANT OPTION;
GRANT SELECT ON ESYS.SYS_BAT_PROGRAM_ARG_S TO EHRM WITH GRANT OPTION;

-- 시노님 생성
CREATE OR REPLACE SYNONYM ECOM.SYS_BAT_PROGRAM_ARG_S FOR ESYS.SYS_BAT_PROGRAM_ARG_S;
CREATE OR REPLACE SYNONYM EHRM.SYS_BAT_PROGRAM_ARG_S FOR ESYS.SYS_BAT_PROGRAM_ARG_S;


-- ------------------------------------------------------------------------------------------------
-- 테이블 생성
-- ------------------------------------------------------------------------------------------------
DROP   TABLE ESYS.SYS_BAT_PROGRAM_ARG CASCADE CONSTRAINTS;
CREATE TABLE ESYS.SYS_BAT_PROGRAM_ARG
(
     CORP_ID                  NUMBER         NOT NULL
    ,BAT_PROGRAM_ID           NUMBER         NOT NULL
    ,BAT_PROGRAM_ARG_ID       NUMBER         NOT NULL
    ,BAT_ARGUMENT             VARCHAR2(100)  NOT NULL
    ,BAT_ARGUMENT_NAME        VARCHAR2(200)  NOT NULL
    ,BAT_ARGUMENT_SHORT_NAME  VARCHAR2(100)  NOT NULL
    ,IN_OUT                   VARCHAR2(30)   DEFAULT 'IN' NOT NULL
    ,DATA_TYPE                VARCHAR2(30)   DEFAULT 'VARCHAR2' NOT NULL
    ,SORT_ORDER               NUMBER         DEFAULT 1
    ,ARGUMENT_VALUE           VARCHAR2(200)
    ,REMARK                   VARCHAR2(4000)
    ,CREATE_DATE              DATE           DEFAULT SYSDATE
    ,CREATE_BY                VARCHAR2(50)   DEFAULT '-1'
    ,UPDATE_DATE              DATE           DEFAULT SYSDATE
    ,UPDATE_BY                VARCHAR2(50)   DEFAULT '-1'
) TABLESPACE EAPEX_DATA;

-- 테이블 설명
COMMENT ON TABLE  ESYS.SYS_BAT_PROGRAM_ARG                         IS '[시스템관리] 배치프로그램-매개변수';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM_ARG.CORP_ID                 IS '법인ID';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM_ARG.BAT_PROGRAM_ID          IS '배치프로그램ID';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM_ARG.BAT_PROGRAM_ARG_ID      IS '매개변수ID';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM_ARG.BAT_ARGUMENT            IS '매개변수';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM_ARG.BAT_ARGUMENT_NAME       IS '매개변수명';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM_ARG.BAT_ARGUMENT_SHORT_NAME IS '매개변수명(약칭)';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM_ARG.IN_OUT                  IS 'IN/OUT';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM_ARG.DATA_TYPE               IS '데이터유형';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM_ARG.SORT_ORDER              IS '정렬순서';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM_ARG.ARGUMENT_VALUE          IS '매개변수값';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM_ARG.REMARK                  IS '비고';

COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM_ARG.CREATE_DATE             IS '생성일시';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM_ARG.CREATE_BY               IS '생성자';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM_ARG.UPDATE_DATE             IS '수정일시';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM_ARG.UPDATE_BY               IS '수정자';

-- PRIMARY 인덱스
ALTER TABLE ESYS.SYS_BAT_PROGRAM_ARG ADD CONSTRAINT SYS_BAT_PROGRAM_ARG_PK PRIMARY KEY (BAT_PROGRAM_ARG_ID) USING INDEX TABLESPACE EAPEX_IDX;

-- UNIQUE 인덱스
CREATE UNIQUE INDEX ESYS.SYS_BAT_PROGRAM_ARG_UK01 ON ESYS.SYS_BAT_PROGRAM_ARG (CORP_ID, BAT_PROGRAM_ID, BAT_ARGUMENT) TABLESPACE EAPEX_IDX;

-- NORMAL 인덱스
CREATE INDEX ESYS.SYS_BAT_PROGRAM_ARG_IX01 ON ESYS.SYS_BAT_PROGRAM_ARG (CORP_ID, BAT_ARGUMENT_NAME, SORT_ORDER) TABLESPACE EAPEX_IDX;

-- 권한부여
GRANT SELECT, INSERT, UPDATE, DELETE ON ESYS.SYS_BAT_PROGRAM_ARG TO ECOM WITH GRANT OPTION;
GRANT SELECT, INSERT, UPDATE, DELETE ON ESYS.SYS_BAT_PROGRAM_ARG TO EHRM WITH GRANT OPTION;

-- 시노님 생성
CREATE OR REPLACE SYNONYM ECOM.SYS_BAT_PROGRAM_ARG FOR ESYS.SYS_BAT_PROGRAM_ARG;
CREATE OR REPLACE SYNONYM EHRM.SYS_BAT_PROGRAM_ARG FOR ESYS.SYS_BAT_PROGRAM_ARG;

