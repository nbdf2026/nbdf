-- ------------------------------------------------------------------------------------------------
-- [시스템관리] 배치작업등록 오브젝트 생성
CONN SYSTEM/MANAGER@DEV1213;
-- ------------------------------------------------------------------------------------------------


-- ------------------------------------------------------------------------------------------------
-- 테이블 생성
-- ------------------------------------------------------------------------------------------------
DROP   TABLE ESYS.SYS_BAT_JOB CASCADE CONSTRAINTS;
CREATE TABLE ESYS.SYS_BAT_JOB
(
     CORP_ID                 NUMBER         NOT NULL
    ,BAT_PROGRAM_ID          NUMBER         NOT NULL
	,BAT_JOB_ID              NUMBER         NOT NULL
    ,BAT_REPEAT_CYCLE        VARCHAR2(200)
    ,CREATE_DATE             DATE           DEFAULT SYSDATE
    ,CREATE_BY               VARCHAR2(50)   DEFAULT '-1'
    ,UPDATE_DATE             DATE           DEFAULT SYSDATE
    ,UPDATE_BY               VARCHAR2(50)   DEFAULT '-1'
) TABLESPACE EAPEX_DATA;

-- 테이블 설명
COMMENT ON TABLE  ESYS.SYS_BAT_JOB                        IS '[시스템관리] 배치작업등록';
COMMENT ON COLUMN ESYS.SYS_BAT_JOB.CORP_ID                IS '법인ID';
COMMENT ON COLUMN ESYS.SYS_BAT_JOB.BAT_PROGRAM_ID         IS '배치프로그램ID';
COMMENT ON COLUMN ESYS.SYS_BAT_JOB.BAT_JOB_ID             IS '배치작업ID';
COMMENT ON COLUMN ESYS.SYS_BAT_JOB.BAT_REPEAT_CYCLE       IS '배치작업주기';

COMMENT ON COLUMN ESYS.SYS_BAT_JOB.CREATE_DATE            IS '생성일시';
COMMENT ON COLUMN ESYS.SYS_BAT_JOB.CREATE_BY              IS '생성자';
COMMENT ON COLUMN ESYS.SYS_BAT_JOB.UPDATE_DATE            IS '수정일시';
COMMENT ON COLUMN ESYS.SYS_BAT_JOB.UPDATE_BY              IS '수정자';

-- PRIMARY 인덱스
ALTER TABLE ESYS.SYS_BAT_JOB ADD CONSTRAINT SYS_BAT_JOB_PK PRIMARY KEY (BAT_PROGRAM_ID, BAT_JOB_ID) USING INDEX TABLESPACE EAPEX_IDX;

-- NORMAL 인덱스
CREATE INDEX ESYS.SYS_BAT_JOB_IX01 ON ESYS.SYS_BAT_JOB (CORP_ID, BAT_PROGRAM_ID, BAT_REPEAT_CYCLE) TABLESPACE EAPEX_IDX;

-- 권한부여
GRANT SELECT, INSERT, UPDATE, DELETE ON ESYS.SYS_BAT_JOB TO ECOM WITH GRANT OPTION;
GRANT SELECT, INSERT, UPDATE, DELETE ON ESYS.SYS_BAT_JOB TO EHRM WITH GRANT OPTION;

-- 시노님 생성
CREATE OR REPLACE SYNONYM ECOM.SYS_BAT_JOB FOR ESYS.SYS_BAT_JOB;
CREATE OR REPLACE SYNONYM EHRM.SYS_BAT_JOB FOR ESYS.SYS_BAT_JOB;

