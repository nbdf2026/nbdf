-- ------------------------------------------------------------------------------------------------
-- [시스템관리] 배치프로그램등록 오브젝트 생성
CONN SYSTEM/MANAGER@DEV1213;
-- ------------------------------------------------------------------------------------------------

-- ------------------------------------------------------------------------------------------------
-- 시퀀스 생성
-- ------------------------------------------------------------------------------------------------
DROP   SEQUENCE ESYS.SYS_BAT_PROGRAM_S;
CREATE SEQUENCE ESYS.SYS_BAT_PROGRAM_S
MINVALUE 1
MAXVALUE 999999999999
START WITH 1000000
INCREMENT BY 1
ORDER;

-- 권한 부여
GRANT SELECT ON ESYS.SYS_BAT_PROGRAM_S TO ESYS WITH GRANT OPTION;
GRANT SELECT ON ESYS.SYS_BAT_PROGRAM_S TO EHRM WITH GRANT OPTION;

-- 시노님 생성
CREATE OR REPLACE SYNONYM ECOM.SYS_BAT_PROGRAM_S FOR ESYS.SYS_BAT_PROGRAM_S;
CREATE OR REPLACE SYNONYM EHRM.SYS_BAT_PROGRAM_S FOR ESYS.SYS_BAT_PROGRAM_S;


-- ------------------------------------------------------------------------------------------------
-- 테이블 생성
-- ------------------------------------------------------------------------------------------------
DROP   TABLE ESYS.SYS_BAT_PROGRAM CASCADE CONSTRAINTS;
CREATE TABLE ESYS.SYS_BAT_PROGRAM
(
     CORP_ID                 NUMBER         NOT NULL
    ,BAT_PROGRAM_ID          NUMBER         NOT NULL
	,BAT_PROGRAM_NAME        VARCHAR2(200)  NOT NULL
    ,BAT_PROGRAM_SHORT_NAME  VARCHAR2(100)  NOT NULL
    ,START_DATE              DATE           DEFAULT SYSDATE NOT NULL    
    ,END_DATE                DATE
    ,REMARK                  VARCHAR2(4000)
    ,CREATE_DATE             DATE           DEFAULT SYSDATE
    ,CREATE_BY               VARCHAR2(50)   DEFAULT '-1'
    ,UPDATE_DATE             DATE           DEFAULT SYSDATE
    ,UPDATE_BY               VARCHAR2(50)   DEFAULT '-1'
) TABLESPACE EAPEX_DATA;

-- 테이블 설명
COMMENT ON TABLE  ESYS.SYS_BAT_PROGRAM                        IS '[시스템관리] 배치프로그램등록';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM.CORP_ID                IS '법인ID';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM.BAT_PROGRAM_ID         IS '배치프로그램ID';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM.BAT_PROGRAM_NAME       IS '배치프로그램명';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM.BAT_PROGRAM_SHORT_NAME IS '배치프로그램명(약칭)';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM.START_DATE             IS '시작일자';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM.END_DATE               IS '종료일자';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM.REMARK                 IS '비고';

COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM.CREATE_DATE            IS '생성일시';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM.CREATE_BY              IS '생성자';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM.UPDATE_DATE            IS '수정일시';
COMMENT ON COLUMN ESYS.SYS_BAT_PROGRAM.UPDATE_BY              IS '수정자';

-- PRIMARY 인덱스
ALTER TABLE ESYS.SYS_BAT_PROGRAM ADD CONSTRAINT SYS_BAT_PROGRAM_PK PRIMARY KEY (BAT_PROGRAM_ID) USING INDEX TABLESPACE EAPEX_IDX;

-- UNIQUE 인덱스
CREATE UNIQUE INDEX ESYS.SYS_BAT_PROGRAM_UK01 ON ESYS.SYS_BAT_PROGRAM (CORP_ID, BAT_PROGRAM_NAME) TABLESPACE EAPEX_IDX;

-- 권한부여
GRANT SELECT, INSERT, UPDATE, DELETE ON ESYS.SYS_BAT_PROGRAM TO ECOM WITH GRANT OPTION;
GRANT SELECT, INSERT, UPDATE, DELETE ON ESYS.SYS_BAT_PROGRAM TO EHRM WITH GRANT OPTION;

-- 시노님 생성
CREATE OR REPLACE SYNONYM ECOM.SYS_BAT_PROGRAM FOR ESYS.SYS_BAT_PROGRAM;
CREATE OR REPLACE SYNONYM EHRM.SYS_BAT_PROGRAM FOR ESYS.SYS_BAT_PROGRAM;

