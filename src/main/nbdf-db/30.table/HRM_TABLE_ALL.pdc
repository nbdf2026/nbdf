-- ------------------------------------------------------------------------------------------------
-- 테이블 생성
DROP   TABLE EHRM.HRM_HOLIDAY CASCADE CONSTRAINTS;
CREATE TABLE EHRM.HRM_HOLIDAY
(
     CORP_ID                 NUMBER         NOT NULL
    ,HOLIDAY_ID              NUMBER         NOT NULL    
    ,HOLIDAY                 DATE           NOT NULL
    ,HOLIDAY_NAME            VARCHAR2(200)  NOT NULL
    ,HOLIDAY_SHORT_NAME      VARCHAR2(100)  NOT NULL    
    ,REMARK                  VARCHAR2(4000)
    ,CREATE_DATE             DATE           DEFAULT SYSDATE
    ,CREATE_BY               VARCHAR2(50)   DEFAULT '-1'
    ,UPDATE_DATE             DATE           DEFAULT SYSDATE
    ,UPDATE_BY               VARCHAR2(50)   DEFAULT '-1'
) TABLESPACE EAPEX_DATA;

-- 테이블 설명
COMMENT ON TABLE  EHRM.HRM_HOLIDAY                       IS '[인사관리] 국공휴일';
COMMENT ON COLUMN EHRM.HRM_HOLIDAY.CORP_ID               IS '법인ID';
COMMENT ON COLUMN EHRM.HRM_HOLIDAY.HOLIDAY_ID            IS '국공휴일ID';
COMMENT ON COLUMN EHRM.HRM_HOLIDAY.HOLIDAY               IS '국공휴일자';
COMMENT ON COLUMN EHRM.HRM_HOLIDAY.HOLIDAY_NAME          IS '국공휴일명';
COMMENT ON COLUMN EHRM.HRM_HOLIDAY.HOLIDAY_SHORT_NAME    IS '국공휴일명(약칭)';
COMMENT ON COLUMN EHRM.HRM_HOLIDAY.REMARK                IS '비고';

COMMENT ON COLUMN EHRM.HRM_HOLIDAY.CREATE_DATE           IS '생성일시';
COMMENT ON COLUMN EHRM.HRM_HOLIDAY.CREATE_BY             IS '생성자';
COMMENT ON COLUMN EHRM.HRM_HOLIDAY.UPDATE_DATE           IS '수정일시';
COMMENT ON COLUMN EHRM.HRM_HOLIDAY.UPDATE_BY             IS '수정자';

-- PRIMARY 인덱스
ALTER TABLE EHRM.HRM_HOLIDAY ADD CONSTRAINT HRM_HOLIDAY_PK PRIMARY KEY (HOLIDAY_ID) USING INDEX TABLESPACE EAPEX_IDX;

-- UNIQUE 인덱스
CREATE UNIQUE INDEX EHRM.HRM_HOLIDAY_UK01 ON EHRM.HRM_HOLIDAY (CORP_ID, HOLIDAY) TABLESPACE EAPEX_IDX;

-- NORMAL 인덱스
CREATE INDEX EHRM.HRM_HOLIDAY_IX01 ON EHRM.HRM_HOLIDAY (HOLIDAY_NAME) TABLESPACE EAPEX_IDX;

-- 권한부여
GRANT SELECT, INSERT, UPDATE, DELETE ON EHRM.HRM_HOLIDAY TO ESYS WITH GRANT OPTION;
GRANT SELECT, INSERT, UPDATE, DELETE ON EHRM.HRM_HOLIDAY TO ECOM WITH GRANT OPTION;

-- 트리거 생성
CREATE OR REPLACE TRIGGER EHRM.HRM_HOLIDAY_TRG
    BEFORE INSERT OR UPDATE ON EHRM.HRM_HOLIDAY
    FOR EACH ROW
BEGIN
    :NEW.UPDATE_DATE := SYSDATE;    
    IF INSERTING THEN :NEW.CREATE_DATE := SYSDATE; END IF;
END;
/

-- 시노님 생성
CREATE OR REPLACE SYNONYM ESYS.HRM_HOLIDAY FOR EHRM.HRM_HOLIDAY;
CREATE OR REPLACE SYNONYM ECOM.HRM_HOLIDAY FOR EHRM.HRM_HOLIDAY;



