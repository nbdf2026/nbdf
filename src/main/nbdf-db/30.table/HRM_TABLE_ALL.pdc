-- 테이블 생성
DROP   TABLE EHRM.HRM_ABSENCE_REQ CASCADE CONSTRAINTS;
CREATE TABLE EHRM.HRM_ABSENCE_REQ
(
     CORP_ID                 NUMBER         NOT NULL
    ,ABSENCE_REQ_ID          NUMBER         NOT NULL    
    ,REQ_EMP_ID              NUMBER         NOT NULL
    ,REQ_DEPT_ID             NUMBER         NOT NULL
    ,REQ_DATE                DATE           DEFAULT TRUNC(SYSDATE) NOT NULL
    ,ABSENCE_TYPE_CD         VARCHAR2(30)   NOT NULL
    ,START_DATE              DATE           DEFAULT TRUNC(SYSDATE) NOT NULL
    ,END_DATE                DATE
    ,HALF_DAY_YN             VARCHAR2(1)    DEFAULT 'N' NOT NULL
    ,ABSENCE_DAY             NUMBER         DEFAULT 1    
    ,APPROVAL_EMP_ID         NUMBER         NOT NULL    
    ,REMARK                  VARCHAR2(4000)
    ,CREATE_DATE             DATE           DEFAULT SYSDATE
    ,CREATE_BY               VARCHAR2(50)   DEFAULT '-1'
    ,UPDATE_DATE             DATE           DEFAULT SYSDATE
    ,UPDATE_BY               VARCHAR2(50)   DEFAULT '-1'
) TABLESPACE EAPEX_DATA;

-- 테이블 설명
COMMENT ON TABLE  EHRM.HRM_ABSENCE_REQ                       IS '[인사관리] 부재신청';
COMMENT ON COLUMN EHRM.HRM_ABSENCE_REQ.CORP_ID               IS '법인ID';
COMMENT ON COLUMN EHRM.HRM_ABSENCE_REQ.ABSENCE_REQ_ID        IS '휴가신청ID';
COMMENT ON COLUMN EHRM.HRM_ABSENCE_REQ.REQ_EMP_ID            IS '신청인임직원ID';
COMMENT ON COLUMN EHRM.HRM_ABSENCE_REQ.REQ_DEPT_ID           IS '신청인분서ID';
COMMENT ON COLUMN EHRM.HRM_ABSENCE_REQ.REQ_DATE              IS '신청일자';
COMMENT ON COLUMN EHRM.HRM_ABSENCE_REQ.ABSENCE_TYPE_CD       IS '휴가유형코드';
COMMENT ON COLUMN EHRM.HRM_ABSENCE_REQ.START_DATE            IS '시작일자';
COMMENT ON COLUMN EHRM.HRM_ABSENCE_REQ.END_DATE              IS '종료일자';
COMMENT ON COLUMN EHRM.HRM_ABSENCE_REQ.HALF_DAY_YN           IS '반차여부';
COMMENT ON COLUMN EHRM.HRM_ABSENCE_REQ.ABSENCE_DAY           IS '휴가일수';
COMMENT ON COLUMN EHRM.HRM_ABSENCE_REQ.APPROVAL_EMP_ID       IS '승인자임직원ID';
COMMENT ON COLUMN EHRM.HRM_ABSENCE_REQ.REMARK                IS '비고';

COMMENT ON COLUMN EHRM.HRM_ABSENCE_REQ.CREATE_DATE           IS '생성일시';
COMMENT ON COLUMN EHRM.HRM_ABSENCE_REQ.CREATE_BY             IS '생성자';
COMMENT ON COLUMN EHRM.HRM_ABSENCE_REQ.UPDATE_DATE           IS '수정일시';
COMMENT ON COLUMN EHRM.HRM_ABSENCE_REQ.UPDATE_BY             IS '수정자';

-- PRIMARY 인덱스
ALTER TABLE EHRM.HRM_ABSENCE_REQ ADD CONSTRAINT HRM_ABSENCE_REQ_PK PRIMARY KEY (ABSENCE_REQ_ID) USING INDEX TABLESPACE EAPEX_IDX;

-- UNIQUE 인덱스
CREATE UNIQUE INDEX EHRM.HRM_ABSENCE_REQ_UK01 ON EHRM.HRM_ABSENCE_REQ (CORP_ID, REQ_EMP_ID, START_DATE, END_DATE) TABLESPACE EAPEX_IDX;

-- NORMAL 인덱스
CREATE INDEX EHRM.HRM_ABSENCE_REQ_IX01 ON EHRM.HRM_ABSENCE_REQ (APPROVAL_EMP_ID) TABLESPACE EAPEX_IDX;

-- 권한부여
GRANT SELECT, INSERT, UPDATE, DELETE ON EHRM.HRM_ABSENCE_REQ TO ESYS WITH GRANT OPTION;
GRANT SELECT, INSERT, UPDATE, DELETE ON EHRM.HRM_ABSENCE_REQ TO ECOM WITH GRANT OPTION;

-- 트리거 생성
CREATE OR REPLACE TRIGGER EHRM.HRM_ABSENCE_REQ_TRG
    BEFORE INSERT OR UPDATE ON EHRM.HRM_ABSENCE_REQ
    FOR EACH ROW
DECLARE
    L_ABSENCE_DAY    NUMBER DEFAULT NULL;
BEGIN    
    :NEW.UPDATE_DATE := SYSDATE;    
    
    L_ABSENCE_DAY := HRM_ABSENCE_REQ_API.ABSENCE_DAY_F(:NEW.START_DATE, :NEW.END_DATE, :NEW.HALF_DAY_YN);
      
    --DBMS_OUTPUT.PUT_LINE(':NEW.ABSENCE_REQ_ID => ' || :NEW.ABSENCE_REQ_ID);
    --DBMS_OUTPUT.PUT_LINE(':NEW.START_DATE     => ' || :NEW.START_DATE);
    --DBMS_OUTPUT.PUT_LINE(':NEW.END_DATE       => ' || :NEW.END_DATE);
    --DBMS_OUTPUT.PUT_LINE(':NEW.HALF_DAY_YN    => ' || :NEW.HALF_DAY_YN);
    --DBMS_OUTPUT.PUT_LINE('L_ABSENCE_DAY       => ' || L_ABSENCE_DAY);
    
    IF INSERTING THEN 
        :NEW.CREATE_DATE := SYSDATE;
        :NEW.ABSENCE_DAY := L_ABSENCE_DAY;
    END IF;
    
    IF UPDATING THEN
        :NEW.ABSENCE_DAY := L_ABSENCE_DAY;
        NULL;
    END IF;
END;
/

-- 시노님 생성
CREATE OR REPLACE SYNONYM ESYS.HRM_ABSENCE_REQ FOR EHRM.HRM_ABSENCE_REQ;
CREATE OR REPLACE SYNONYM ECOM.HRM_ABSENCE_REQ FOR EHRM.HRM_ABSENCE_REQ;



