COMMENT ON COLUMN EHRM.HRM_DEPT.START_DATE       IS '시작일자';
COMMENT ON COLUMN EHRM.HRM_DEPT.END_DATE         IS '종료일자';
COMMENT ON COLUMN EHRM.HRM_DEPT.COST_CENTER_CD   IS '원가코드';
COMMENT ON COLUMN EHRM.HRM_DEPT.BUDGET_CD        IS '예산코드';
COMMENT ON COLUMN EHRM.HRM_DEPT.EXPENSE_CD       IS '비용코드';
COMMENT ON COLUMN EHRM.HRM_DEPT.DEPT_MANAGER_ID  IS '부서관리자id';
COMMENT ON COLUMN EHRM.HRM_DEPT.REGION_CD        IS '지역코드';
COMMENT ON COLUMN EHRM.HRM_DEPT.TEL_NUM          IS '전화번호';
COMMENT ON COLUMN EHRM.HRM_DEPT.FAX_NUM          IS '팩스번호';
COMMENT ON COLUMN EHRM.HRM_DEPT.SORT_ORDER       IS '정렬순서';
COMMENT ON COLUMN EHRM.HRM_DEPT.REMARK           IS '비고';

COMMENT ON COLUMN EHRM.HRM_DEPT.CREATE_DATE      IS '생성일시';
COMMENT ON COLUMN EHRM.HRM_DEPT.CREATE_BY        IS '생성자';
COMMENT ON COLUMN EHRM.HRM_DEPT.UPDATE_DATE      IS '수정일시';
COMMENT ON COLUMN EHRM.HRM_DEPT.UPDATE_BY        IS '수정자';

-- PRIMARY 인덱스
ALTER TABLE EHRM.HRM_DEPT ADD CONSTRAINT HRM_DEPT_PK PRIMARY KEY (DEPT_ID) USING INDEX TABLESPACE EAPEX_IDX;

-- UNIQUE 인덱스
CREATE UNIQUE INDEX EHRM.HRM_DEPT_UK01 ON EHRM.HRM_DEPT (CORP_ID, DEPT_CD, START_DATE) TABLESPACE EAPEX_IDX;

-- NORMAL 인덱스
CREATE INDEX EHRM.HRM_DEPT_IX01 ON EHRM.HRM_DEPT (DEPT_NAME) TABLESPACE EAPEX_IDX;

