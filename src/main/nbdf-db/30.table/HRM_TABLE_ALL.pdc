GRANT SELECT, INSERT, UPDATE, DELETE ON EHRM.HRM_DEPT TO ECOM WITH GRANT OPTION;

-- 트리거 생성
CREATE OR REPLACE TRIGGER EHRM.HRM_DEPT_TRG
    BEFORE INSERT OR UPDATE ON EHRM.HRM_DEPT
    FOR EACH ROW
BEGIN
    IF :NEW.DEPT_ID IS NULL THEN    
        :NEW.DEPT_ID  := HRM_DEPT_S.NEXTVAL;        
    END IF;
    
    IF INSERTING THEN
        :NEW.CREATE_DATE := SYSDATE;
        :NEW.CREATE_BY   := NVL(WWV_FLOW.G_USER, USER);
    END IF;
    
    :NEW.UPDATE_DATE := SYSDATE;
    :NEW.UPDATE_BY   := NVL(WWV_FLOW.G_USER, USER);
END;
/

