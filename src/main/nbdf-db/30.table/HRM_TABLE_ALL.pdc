CONN SYSTEM/MANAGER@DEV1213;

-- ------------------------------------------------------------------------------------------------
-- [ 인사관리 ] 법인 테이블 생성
-- ------------------------------------------------------------------------------------------------
-- 테이블 생성
DROP   TABLE EHRM.HRM_CORPORATION CASCADE CONSTRAINTS;
CREATE TABLE EHRM.HRM_CORPORATION
(
     CORP_ID                 NUMBER         NOT NULL
    ,CORP_CD                 VARCHAR2(50)   NOT NULL
    ,CORP_NAME               VARCHAR2(200)  NOT NULL
    ,CORP_SHORT_NAME         VARCHAR2(100)  NOT NULL
    ,CORP_NUM                VARCHAR2(2000) NOT NULL
    ,BIZ_NUM                 VARCHAR2(2000) NOT NULL
    ,REPRE_SSN1              VARCHAR2(2000) NOT NULL
    ,REPRE_NAME1             VARCHAR2(50)   NOT NULL    
    ,REPRE_SSN2              VARCHAR2(2000)
    ,REPRE_NAME2             VARCHAR2(50)
    ,ESTAB_DATE              DATE           NOT NULL
    ,START_DATE              DATE           DEFAULT TRUNC(SYSDATE) NOT NULL
    ,END_DATE                DATE
    ,TEL_NUM                 VARCHAR2(20)
    ,FAX_NUM                 VARCHAR2(20)
    ,ADDRESS1                VARCHAR2(300)
    ,ADDRESS2                VARCHAR2(300)
    ,POSTAL_CODE             VARCHAR2(10)
    ,HOME_TAX_ID             VARCHAR2(20)
    ,REGION_CD               VARCHAR2(50)   NOT NULL
    ,TAX_OFFICE_CD           VARCHAR2(30)   NOT NULL
    ,HEALTH_INS_NUM          VARCHAR2(30)   NOT NULL
    ,NAT_PEN_NUM             VARCHAR2(30)   NOT NULL
    ,EMP_INS_NUM             VARCHAR2(30)   NOT NULL
    ,IND_ACC_NUM             VARCHAR2(30)   NOT NULL
    ,REMARK                  VARCHAR2(4000)
    ,CREATE_DATE             DATE           DEFAULT SYSDATE
    ,CREATE_BY               VARCHAR2(50)   DEFAULT '-1'
    ,UPDATE_DATE             DATE           DEFAULT SYSDATE
    ,UPDATE_BY               VARCHAR2(50)   DEFAULT '-1'
) TABLESPACE EAPEX_DATA;

-- 테이블 설명
COMMENT ON TABLE  EHRM.HRM_CORPORATION                         IS '[인사관리] 법인';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.CORP_ID                 IS '법인ID';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.CORP_CD                 IS '법인코드';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.CORP_NAME               IS '법인명';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.CORP_SHORT_NAME         IS '법인명(약칭)';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.CORP_NUM                IS '법인번호';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.BIZ_NUM                 IS '사업자번호';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.REPRE_SSN1              IS '대표자주민번호1';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.REPRE_NAME1             IS '대표자명1';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.REPRE_SSN2              IS '대표자주민번호2';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.REPRE_NAME2             IS '대표자명2';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.ESTAB_DATE              IS '설립일자';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.START_DATE              IS '시작일자';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.END_DATE                IS '종료일자';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.TEL_NUM                 IS '전화번호';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.FAX_NUM                 IS '팩스번호';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.ADDRESS1                IS '주소';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.ADDRESS2                IS '상세주소';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.POSTAL_CODE             IS '우편번호';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.HOME_TAX_ID             IS '홈덱스id';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.REGION_CD               IS '지역코드';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.TAX_OFFICE_CD           IS '세무서코드';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.HEALTH_INS_NUM          IS '건강보험번호';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.NAT_PEN_NUM             IS '국민보험번호';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.EMP_INS_NUM             IS '고용보험번호';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.IND_ACC_NUM             IS '산재보험번호';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.REMARK                  IS '비고';

COMMENT ON COLUMN EHRM.HRM_CORPORATION.CREATE_DATE             IS '생성일시';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.CREATE_BY               IS '생성자';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.UPDATE_DATE             IS '수정일시';
COMMENT ON COLUMN EHRM.HRM_CORPORATION.UPDATE_BY               IS '수정자';

-- PRIMARY 인덱스
ALTER TABLE EHRM.HRM_CORPORATION ADD CONSTRAINT HRM_CORPORATION_PK PRIMARY KEY (CORP_ID) USING INDEX TABLESPACE EAPEX_IDX;

-- UNIQUE 인덱스
CREATE UNIQUE INDEX EHRM.HRM_CORPORATION_UK01 ON EHRM.HRM_CORPORATION (CORP_CD) TABLESPACE EAPEX_IDX;
CREATE UNIQUE INDEX EHRM.HRM_CORPORATION_UK02 ON EHRM.HRM_CORPORATION (CORP_NUM) TABLESPACE EAPEX_IDX;

-- NORMAL 인덱스
CREATE INDEX EHRM.HRM_CORPORATION_IX01 ON EHRM.HRM_CORPORATION (CORP_NAME) TABLESPACE EAPEX_IDX;
CREATE INDEX EHRM.HRM_CORPORATION_IX02 ON EHRM.HRM_CORPORATION (CORP_SHORT_NAME) TABLESPACE EAPEX_IDX;

-- 권한부여
GRANT SELECT, INSERT, UPDATE, DELETE ON EHRM.HRM_CORPORATION TO ESYS WITH GRANT OPTION;
GRANT SELECT, INSERT, UPDATE, DELETE ON EHRM.HRM_CORPORATION TO ECOM WITH GRANT OPTION;

-- 트리거 생성
CREATE OR REPLACE TRIGGER EHRM.HRM_CORPORATION_TRG
    BEFORE INSERT OR UPDATE ON EHRM.HRM_CORPORATION
    FOR EACH ROW
BEGIN
    IF :NEW.CORP_ID IS NULL THEN    
        :NEW.CORP_ID  := HRM_CORPORATION_S.NEXTVAL;        
    END IF;
    
    IF INSERTING THEN
        :NEW.CREATE_DATE := SYSDATE;
        :NEW.CREATE_BY   := NVL(WWV_FLOW.G_USER, USER);
    END IF;
    
    :NEW.UPDATE_DATE := SYSDATE;
    :NEW.UPDATE_BY   := NVL(WWV_FLOW.G_USER, USER);
END;
/

-- 시노님 생성
CREATE OR REPLACE SYNONYM ESYS.HRM_CORPORATION FOR EHRM.HRM_CORPORATION;
CREATE OR REPLACE SYNONYM ECOM.HRM_CORPORATION FOR EHRM.HRM_CORPORATION;




