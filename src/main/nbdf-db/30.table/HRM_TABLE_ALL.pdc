COMMENT ON COLUMN EHRM.HRM_DEPT_HIERARCHY_DETAIL.UPDATE_BY                 IS '수정자';

-- PRIMARY 인덱스
ALTER TABLE EHRM.HRM_DEPT_HIERARCHY_DETAIL ADD CONSTRAINT HRM_DEPT_HIERARCHY_DETAIL_PK PRIMARY KEY (DEPT_HIERARCHY_DETAIL_ID) USING INDEX TABLESPACE EAPEX_IDX;

-- UNIQUE 인덱스
CREATE UNIQUE INDEX EHRM.HRM_DEPT_HIERARCHY_DETAIL_UK01 ON EHRM.HRM_DEPT_HIERARCHY_DETAIL (DEPT_HIERARCHY_ID, PARENT_DEPT_ID, CHILD_DEPT_ID) TABLESPACE EAPEX_IDX;

-- 권한부여
GRANT SELECT, INSERT, UPDATE, DELETE ON EHRM.HRM_DEPT_HIERARCHY_DETAIL TO ESYS WITH GRANT OPTION;
GRANT SELECT, INSERT, UPDATE, DELETE ON EHRM.HRM_DEPT_HIERARCHY_DETAIL TO ECOM WITH GRANT OPTION;

-- 트리거 생성
CREATE OR REPLACE TRIGGER EHRM.HRM_DEPT_HIERARCHY_DETAIL_TRG
    BEFORE INSERT OR UPDATE ON EHRM.HRM_DEPT_HIERARCHY_DETAIL
    FOR EACH ROW
BEGIN
    IF :NEW.DEPT_HIERARCHY_DETAIL_ID IS NULL THEN    
        :NEW.DEPT_HIERARCHY_DETAIL_ID  := HRM_DEPT_HIERARCHY_DETAIL_S.NEXTVAL;        
    END IF;
    
    IF INSERTING THEN
        :NEW.CREATE_DATE := SYSDATE;
        :NEW.CREATE_BY   := NVL(WWV_FLOW.G_USER, USER);
    END IF;
    
    :NEW.UPDATE_DATE := SYSDATE;
    :NEW.UPDATE_BY   := NVL(WWV_FLOW.G_USER, USER);
END;
/

-- 시노님 생성
CREATE OR REPLACE SYNONYM ESYS.HRM_DEPT_HIERARCHY_DETAIL FOR EHRM.HRM_DEPT_HIERARCHY_DETAIL;
CREATE OR REPLACE SYNONYM ECOM.HRM_DEPT_HIERARCHY_DETAIL FOR EHRM.HRM_DEPT_HIERARCHY_DETAIL;



