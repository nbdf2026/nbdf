-- ------------------------------------------------------------------------------------------------
-- [ 시스템관리 ] 국가 테이블 생성
-- ------------------------------------------------------------------------------------------------
-- 테이블 생성
DROP   TABLE ESYS.SYS_COUNTRY CASCADE CONSTRAINTS;
CREATE TABLE ESYS.SYS_COUNTRY
(
     COUNTRY_ID              NUMBER         NOT NULL
    ,COUNTRY_CD              VARCHAR2(20)   NOT NULL
    ,COUNTRY_NAME            VARCHAR2(200)  NOT NULL
    ,COUNTRY3_CD             VARCHAR2(20)   NOT NULL
    ,LANGUAGE_CD             VARCHAR2(20)   NOT NULL
    ,LANGUAGE_NAME           VARCHAR2(200)  NOT NULL
    ,CURRENCY_CD             VARCHAR2(20)   NOT NULL
    ,CURRENCY_NAME           VARCHAR2(200)  NOT NULL
    ,START_DATE              DATE           DEFAULT TRUNC(SYSDATE) NOT NULL
    ,END_DATE                DATE
    ,SEED_DATA_YN            VARCHAR2(1)    DEFAULT 'N'
    ,REMARK                  VARCHAR2(4000)
    ,CREATE_DATE             DATE           DEFAULT SYSDATE
    ,CREATE_BY               VARCHAR2(50)   DEFAULT '-1'
    ,UPDATE_DATE             DATE           DEFAULT SYSDATE
    ,UPDATE_BY               VARCHAR2(50)   DEFAULT '-1'
);

-- 테이블 설명
COMMENT ON TABLE  ESYS.SYS_COUNTRY                   IS '[시스템관리] 국가';
COMMENT ON COLUMN ESYS.SYS_COUNTRY.COUNTRY_ID        IS '국가ID';
COMMENT ON COLUMN ESYS.SYS_COUNTRY.COUNTRY_CD        IS '국가코드';
COMMENT ON COLUMN ESYS.SYS_COUNTRY.COUNTRY_NAME      IS '국가명';
COMMENT ON COLUMN ESYS.SYS_COUNTRY.COUNTRY3_CD       IS '국가코드3';
COMMENT ON COLUMN ESYS.SYS_COUNTRY.LANGUAGE_CD       IS '언어코드';
COMMENT ON COLUMN ESYS.SYS_COUNTRY.LANGUAGE_NAME     IS '언어명';
COMMENT ON COLUMN ESYS.SYS_COUNTRY.CURRENCY_CD       IS '화폐코드';
COMMENT ON COLUMN ESYS.SYS_COUNTRY.CURRENCY_NAME     IS '화폐명';
COMMENT ON COLUMN ESYS.SYS_COUNTRY.START_DATE        IS '시작일자';
COMMENT ON COLUMN ESYS.SYS_COUNTRY.END_DATE          IS '종료일자';
COMMENT ON COLUMN ESYS.SYS_COUNTRY.SEED_DATA_YN      IS '기초데이터여부';
COMMENT ON COLUMN ESYS.SYS_COUNTRY.REMARK            IS '비고';

COMMENT ON COLUMN ESYS.SYS_COUNTRY.CREATE_DATE       IS '생성일시';
COMMENT ON COLUMN ESYS.SYS_COUNTRY.CREATE_BY         IS '생성자';
COMMENT ON COLUMN ESYS.SYS_COUNTRY.UPDATE_DATE       IS '수정일시';
COMMENT ON COLUMN ESYS.SYS_COUNTRY.UPDATE_BY         IS '수정자';

-- PRIMARY 인덱스
ALTER TABLE ESYS.SYS_COUNTRY ADD CONSTRAINT SYS_COUNTRY_PK PRIMARY KEY (COUNTRY_ID) USING INDEX TABLESPACE EAPEX_IDX;

-- UNIQUE 인덱스
CREATE UNIQUE INDEX ESYS.SYS_COUNTRY_UK ON ESYS.SYS_COUNTRY (COUNTRY_CD, LANGUAGE_CD) TABLESPACE EAPEX_IDX;

-- NORMAL 인덱스
CREATE INDEX ESYS.SYS_COUNTRY_IX01 ON ESYS.SYS_COUNTRY (CURRENCY_CD) TABLESPACE EAPEX_IDX;
CREATE INDEX ESYS.SYS_COUNTRY_IX02 ON ESYS.SYS_COUNTRY (LANGUAGE_CD) TABLESPACE EAPEX_IDX;

-- 권한부여
GRANT SELECT, INSERT, UPDATE, DELETE ON ESYS.SYS_COUNTRY TO ECOM WITH GRANT OPTION;
GRANT SELECT, INSERT, UPDATE, DELETE ON ESYS.SYS_COUNTRY TO EHRM WITH GRANT OPTION;

-- 트리거 생성
CREATE OR REPLACE TRIGGER ESYS.SYS_COUNTRY_TRG
    BEFORE INSERT OR UPDATE ON ESYS.SYS_COUNTRY
    FOR EACH ROW
BEGIN
    IF :NEW.COUNTRY_ID IS NULL THEN
        :NEW.COUNTRY_ID := SYS_COUNTRY_S.NEXTVAL;
    END IF;
    
    IF INSERTING THEN
        :NEW.CREATE_DATE := SYSDATE;
        :NEW.CREATE_BY   := NVL(WWV_FLOW.G_USER, USER);
    END IF;    
    
    :NEW.UPDATE_DATE := SYSDATE;
    :NEW.UPDATE_BY   := NVL(WWV_FLOW.G_USER, USER);
END;
/

-- 시노님 생성
CREATE OR REPLACE SYNONYM ECOM.SYS_COUNTRY FOR ESYS.SYS_COUNTRY;
CREATE OR REPLACE SYNONYM EHRM.SYS_COUNTRY FOR ESYS.SYS_COUNTRY;



