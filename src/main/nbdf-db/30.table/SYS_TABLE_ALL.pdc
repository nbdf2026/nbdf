CONN SYSTEM/MANAGER@DEV1213;

-- ------------------------------------------------------------------------------------------------
-- [ 시스템관리 ] 세션정보 테이블 생성
-- ------------------------------------------------------------------------------------------------
-- 테이블 생성
DROP   TABLE ESYS.SYS_SESSION CASCADE CONSTRAINTS;
CREATE TABLE ESYS.SYS_SESSION
(
	 USER_ID                 VARCHAR2(50)   NOT NULL
    ,USER_NAME               VARCHAR2(200)  NOT NULL
    ,LAST_LOGIN_TIMESTAMP    TIMESTAMP      DEFAULT SYSTIMESTAMP NOT NULL
    ,CORP_ID                 NUMBER
    ,BIZ_ID                  NUMBER
    ,DEPT_ID                 NUMBER
    ,EMP_ID                  NUMBER
    ,LANG_CD                 VARCHAR2(50)   DEFAULT 'KO' NOT NULL
) TABLESPACE EAPEX_DATA;

-- 테이블 설명
COMMENT ON TABLE  ESYS.SYS_SESSION                          IS '[시스템관리] 세션정보';
COMMENT ON COLUMN ESYS.SYS_SESSION.USER_ID                  IS '사용자ID';
COMMENT ON COLUMN ESYS.SYS_SESSION.LAST_LOGIN_TIMESTAMP     IS '최종로그인일시(초)';
COMMENT ON COLUMN ESYS.SYS_SESSION.CORP_ID                  IS '법인ID';
COMMENT ON COLUMN ESYS.SYS_SESSION.BIZ_ID                   IS '사업장ID';
COMMENT ON COLUMN ESYS.SYS_SESSION.DEPT_ID                  IS '부서ID';
COMMENT ON COLUMN ESYS.SYS_SESSION.EMP_ID                   IS '임직원ID';
COMMENT ON COLUMN ESYS.SYS_SESSION.LANG_CD                  IS '언어코드';

-- PRIMARY 인덱스
ALTER TABLE ESYS.SYS_SESSION ADD CONSTRAINT SYS_SESSION_PK PRIMARY KEY (USER_ID) USING INDEX TABLESPACE EAPEX_IDX;

-- 권한부여
GRANT SELECT, INSERT, UPDATE, DELETE ON ESYS.SYS_SESSION TO ECOM WITH GRANT OPTION;
GRANT SELECT, INSERT, UPDATE, DELETE ON ESYS.SYS_SESSION TO EHRM WITH GRANT OPTION;

-- 시노님 생성
CREATE OR REPLACE SYNONYM ECOM.SYS_SESSION FOR ESYS.SYS_SESSION;
CREATE OR REPLACE SYNONYM EHRM.SYS_SESSION FOR ESYS.SYS_SESSION;



-- ------------------------------------------------------------------------------------------------
-- [ 시스템관리 ] 로그 테이블 생성
-- ------------------------------------------------------------------------------------------------
-- 테이블 생성
DROP   TABLE ESYS.SYS_LOG CASCADE CONSTRAINTS;
CREATE TABLE ESYS.SYS_LOG
(
     CORP_ID                 NUMBER         NOT NULL
    ,LOG_ID                  NUMBER         NOT NULL
    ,LOG_NAME                VARCHAR2(200)  NOT NULL
    ,PARAM_PACKAGE           VARCHAR2(200)
    ,PARAM_CORP_ID           NUMBER
    ,PARAM_LANG_CD           VARCHAR2(50)
    ,PARAM_USER_ID           VARCHAR2(50)
    ,PARAM_TRANSACTION_TYPE  VARCHAR2(1)
    ,PARAM_FILE_NAME         VARCHAR2(200)
    ,PARAM_INFO              VARCHAR2(4000)
    ,RESULT_STATUS_CD        VARCHAR2(50)
    ,RESULT_DESCR            VARCHAR2(4000)
    ,CREATE_DATE             DATE           DEFAULT SYSDATE
    ,CREATE_BY               VARCHAR2(50)   DEFAULT '-1'
    ,UPDATE_DATE             DATE           DEFAULT SYSDATE
    ,UPDATE_BY               VARCHAR2(50)   DEFAULT '-1'
);

-- 테이블 설명
COMMENT ON TABLE  ESYS.SYS_LOG                         IS '[시스템관리] 로그';
COMMENT ON COLUMN ESYS.SYS_LOG.CORP_ID                 IS '법인ID';
COMMENT ON COLUMN ESYS.SYS_LOG.LOG_ID                  IS '로그ID';
COMMENT ON COLUMN ESYS.SYS_LOG.LOG_NAME                IS '로그명';
COMMENT ON COLUMN ESYS.SYS_LOG.PARAM_PACKAGE           IS '로그레벨1';
COMMENT ON COLUMN ESYS.SYS_LOG.PARAM_CORP_ID           IS '로그레벨2';
COMMENT ON COLUMN ESYS.SYS_LOG.PARAM_LANG_CD           IS '로그레벨3';
COMMENT ON COLUMN ESYS.SYS_LOG.PARAM_USER_ID           IS '로그레벨4';
COMMENT ON COLUMN ESYS.SYS_LOG.PARAM_TRANSACTION_TYPE  IS '로그레벨5';
COMMENT ON COLUMN ESYS.SYS_LOG.PARAM_FILE_NAME         IS '파일명';
COMMENT ON COLUMN ESYS.SYS_LOG.PARAM_INFO              IS '매개변수';
COMMENT ON COLUMN ESYS.SYS_LOG.RESULT_STATUS_CD        IS '처리결과코드';
COMMENT ON COLUMN ESYS.SYS_LOG.RESULT_DESCR            IS '처리결과';

COMMENT ON COLUMN ESYS.SYS_LOG.CREATE_DATE             IS '생성일시';
COMMENT ON COLUMN ESYS.SYS_LOG.CREATE_BY               IS '생성자';
COMMENT ON COLUMN ESYS.SYS_LOG.UPDATE_DATE             IS '수정일시';
COMMENT ON COLUMN ESYS.SYS_LOG.UPDATE_BY               IS '수정자';

-- PRIMARY 인덱스
ALTER TABLE ESYS.SYS_LOG ADD CONSTRAINT SYS_LOG_PK PRIMARY KEY (LOG_ID) USING INDEX TABLESPACE EAPEX_IDX;

-- NORMAL 인덱스
CREATE INDEX ESYS.SYS_LOG_IX01 ON ESYS.SYS_LOG (CORP_ID, LOG_NAME) TABLESPACE EAPEX_IDX;
CREATE INDEX ESYS.SYS_LOG_IX02 ON ESYS.SYS_LOG (CORP_ID, PARAM_FILE_NAME) TABLESPACE EAPEX_IDX;

-- 권한부여
GRANT SELECT, INSERT, UPDATE, DELETE ON ESYS.SYS_LOG TO ECOM WITH GRANT OPTION;
GRANT SELECT, INSERT, UPDATE, DELETE ON ESYS.SYS_LOG TO EHRM WITH GRANT OPTION;

-- 트리거 생성
CREATE OR REPLACE TRIGGER ESYS.SYS_LOG_TRG
    BEFORE INSERT OR UPDATE ON ESYS.SYS_LOG
    FOR EACH ROW
BEGIN
    IF :NEW.LOG_ID IS NULL THEN    
        :NEW.LOG_ID  := SYS_LOG_S.NEXTVAL;        
    END IF;
    
    IF INSERTING THEN
        :NEW.CREATE_DATE := SYSDATE;
        :NEW.CREATE_BY   := NVL(WWV_FLOW.G_USER, USER);
    END IF;
    
    :NEW.UPDATE_DATE := SYSDATE;
    :NEW.UPDATE_BY   := NVL(WWV_FLOW.G_USER, USER);
END;
/

-- 시노님 생성
CREATE OR REPLACE SYNONYM ECOM.SYS_LOG FOR ESYS.SYS_LOG;
CREATE OR REPLACE SYNONYM EHRM.SYS_LOG FOR ESYS.SYS_LOG;



-- ------------------------------------------------------------------------------------------------
-- [ 시스템관리 ] 오브젝트 테이블 생성
-- ------------------------------------------------------------------------------------------------
-- 테이블 생성
DROP   TABLE ESYS.SYS_OBJECT CASCADE CONSTRAINTS;
CREATE TABLE ESYS.SYS_OBJECT
(
     CORP_ID                 NUMBER         NOT NULL
    ,OWNER                   VARCHAR2(30)   NOT NULL
    ,TABLE_NAME              VARCHAR2(50)   NOT NULL
    ,COLUMN_NAME             VARCHAR2(200)  NOT NULL
    ,COLUMN_NAME_KR          VARCHAR2(200)
    ,KEY_TYPE                VARCHAR2(1)
    ,REC_NAME                VARCHAR2(20)
    ,DATA_TYPE               VARCHAR2(50)
    ,DATA_TYPE_ORG           VARCHAR2(50)
    ,DEFAULT_VALUE           VARCHAR2(200)
    ,PARAM_DEFAULT_VALUE     VARCHAR2(200)
    ,WHO_COLUMN_YN           VARCHAR2(1)
    ,ML_TYPE                 VARCHAR2(1)
    ,LANG_COLUMN_YN          VARCHAR2(1)
    ,NULL_YN                 VARCHAR2(1)
    ,USER_SORT               NUMBER
    ,ALL_SORT                NUMBER
    ,ALL_SORT_MIN            NUMBER
    ,ALL_SORT_MAX            NUMBER
    ,TABLE_SORT              NUMBER
    ,COLUMN_SORT             NUMBER
    ,COLUMN_SIZE             NUMBER
    ,COLUMN_SIZE_MAX         NUMBER
    ,KEY_SORT                NUMBER
    ,CREATE_DATE             DATE           DEFAULT SYSDATE
    ,CREATE_BY               VARCHAR2(50)   DEFAULT '-1'
    ,UPDATE_DATE             DATE           DEFAULT SYSDATE
    ,UPDATE_BY               VARCHAR2(50)   DEFAULT '-1'
);

-- 테이블 설명
COMMENT ON TABLE  ESYS.SYS_OBJECT                          IS '[시스템관리] 오브젝트';
COMMENT ON COLUMN ESYS.SYS_OBJECT.CORP_ID                  IS '법인ID';
COMMENT ON COLUMN ESYS.SYS_OBJECT.OWNER                    IS '소유자';
COMMENT ON COLUMN ESYS.SYS_OBJECT.TABLE_NAME               IS '테이블명';
COMMENT ON COLUMN ESYS.SYS_OBJECT.COLUMN_NAME              IS '컬럼명';
COMMENT ON COLUMN ESYS.SYS_OBJECT.COLUMN_NAME_KR           IS '컬럼영(한글)';
COMMENT ON COLUMN ESYS.SYS_OBJECT.KEY_TYPE                 IS '키유형';
COMMENT ON COLUMN ESYS.SYS_OBJECT.REC_NAME                 IS '레코드명';
COMMENT ON COLUMN ESYS.SYS_OBJECT.DATA_TYPE                IS '데이터유형';
COMMENT ON COLUMN ESYS.SYS_OBJECT.DATA_TYPE_ORG            IS '데이터유형(원천)';
COMMENT ON COLUMN ESYS.SYS_OBJECT.DEFAULT_VALUE            IS '기본값';
COMMENT ON COLUMN ESYS.SYS_OBJECT.PARAM_DEFAULT_VALUE      IS '기본값(매개변수)';
COMMENT ON COLUMN ESYS.SYS_OBJECT.WHO_COLUMN_YN            IS '후컬럼여부';
COMMENT ON COLUMN ESYS.SYS_OBJECT.ML_TYPE                  IS '다국테이블구분';
COMMENT ON COLUMN ESYS.SYS_OBJECT.LANG_COLUMN_YN           IS '다국어컬럼여부';
COMMENT ON COLUMN ESYS.SYS_OBJECT.NULL_YN                  IS '널여부';
COMMENT ON COLUMN ESYS.SYS_OBJECT.USER_SORT                IS '사용자정렬';
COMMENT ON COLUMN ESYS.SYS_OBJECT.ALL_SORT                 IS '전체정렬';
COMMENT ON COLUMN ESYS.SYS_OBJECT.ALL_SORT_MIN             IS '전체정렬(최소)';
COMMENT ON COLUMN ESYS.SYS_OBJECT.ALL_SORT_MAX             IS '전체정렬(최대)';
COMMENT ON COLUMN ESYS.SYS_OBJECT.TABLE_SORT               IS '테이블정렬';
COMMENT ON COLUMN ESYS.SYS_OBJECT.COLUMN_SORT              IS '컬럼정렬';
COMMENT ON COLUMN ESYS.SYS_OBJECT.COLUMN_SIZE              IS '컬럼자릿수';
COMMENT ON COLUMN ESYS.SYS_OBJECT.COLUMN_SIZE_MAX          IS '컬럼자릿수(최대)';
COMMENT ON COLUMN ESYS.SYS_OBJECT.KEY_SORT                 IS '키정렬';

COMMENT ON COLUMN ESYS.SYS_OBJECT.CREATE_DATE              IS '생성일시';
COMMENT ON COLUMN ESYS.SYS_OBJECT.CREATE_BY                IS '생성자';
COMMENT ON COLUMN ESYS.SYS_OBJECT.UPDATE_DATE              IS '수정일시';
COMMENT ON COLUMN ESYS.SYS_OBJECT.UPDATE_BY                IS '수정자';

-- PRIMARY 인덱스
ALTER TABLE ESYS.SYS_OBJECT ADD CONSTRAINT SYS_OBJECT_PK PRIMARY KEY (CORP_ID, OWNER, TABLE_NAME, COLUMN_NAME) USING INDEX TABLESPACE EAPEX_IDX;

-- NORMAL 인덱스
CREATE INDEX ESYS.SYS_OBJECT_IX01 ON ESYS.SYS_OBJECT (CORP_ID, COLUMN_NAME_KR) TABLESPACE EAPEX_IDX;

-- 권한부여
GRANT SELECT, INSERT, UPDATE, DELETE ON ESYS.SYS_OBJECT TO ECOM WITH GRANT OPTION;
GRANT SELECT, INSERT, UPDATE, DELETE ON ESYS.SYS_OBJECT TO EHRM WITH GRANT OPTION;

-- 시노님 생성
CREATE OR REPLACE SYNONYM ECOM.SYS_OBJECT FOR ESYS.SYS_OBJECT;
CREATE OR REPLACE SYNONYM EHRM.SYS_OBJECT FOR ESYS.SYS_OBJECT;



