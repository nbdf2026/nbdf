-- [ 시스템관리 ] 프로파일 테이블 생성
-- ------------------------------------------------------------------------------------------------
-- 테이블 생성
DROP   TABLE ESYS.SYS_PROFILE CASCADE CONSTRAINTS;
CREATE TABLE ESYS.SYS_PROFILE
(
     CORP_ID                 NUMBER         NOT NULL
    ,PROFILE_ID              NUMBER         NOT NULL
    ,PROFILE_CD              VARCHAR2(50)   NOT NULL
    ,PROFILE_NAME            VARCHAR2(200)  NOT NULL
    ,PROFILE_SHORT_NAME      VARCHAR2(100)  NOT NULL
    ,PROFILE_VALUE           VARCHAR2(200)  NOT NULL
    ,START_DATE              DATE           DEFAULT TRUNC(SYSDATE) NOT NULL
    ,END_DATE                DATE
    ,SEED_DATA_YN            VARCHAR2(1)    DEFAULT 'N'
    ,REMARK                  VARCHAR2(4000)
    ,CREATE_DATE             DATE           DEFAULT SYSDATE
    ,CREATE_BY               VARCHAR2(50)   DEFAULT '-1'
    ,UPDATE_DATE             DATE           DEFAULT SYSDATE
    ,UPDATE_BY               VARCHAR2(50)   DEFAULT '-1'
);

-- 테이블 설명
COMMENT ON TABLE  ESYS.SYS_PROFILE                    IS '[시스템관리] 프로파일';
COMMENT ON COLUMN ESYS.SYS_PROFILE.CORP_ID            IS '법인ID';
COMMENT ON COLUMN ESYS.SYS_PROFILE.PROFILE_ID         IS '프로파일ID';
COMMENT ON COLUMN ESYS.SYS_PROFILE.PROFILE_CD         IS '프로파일코드';
COMMENT ON COLUMN ESYS.SYS_PROFILE.PROFILE_NAME       IS '프로파일명';
COMMENT ON COLUMN ESYS.SYS_PROFILE.PROFILE_SHORT_NAME IS '프로파일명(약칭)';
COMMENT ON COLUMN ESYS.SYS_PROFILE.PROFILE_VALUE      IS '프로파일값';
COMMENT ON COLUMN ESYS.SYS_PROFILE.START_DATE         IS '시작일자';
COMMENT ON COLUMN ESYS.SYS_PROFILE.END_DATE           IS '종료일자';
COMMENT ON COLUMN ESYS.SYS_PROFILE.SEED_DATA_YN       IS '기초데이터여부';
COMMENT ON COLUMN ESYS.SYS_PROFILE.REMARK             IS '비고';

COMMENT ON COLUMN ESYS.SYS_PROFILE.CREATE_DATE        IS '생성일시';
COMMENT ON COLUMN ESYS.SYS_PROFILE.CREATE_BY          IS '생성자';
COMMENT ON COLUMN ESYS.SYS_PROFILE.UPDATE_DATE        IS '수정일시';
COMMENT ON COLUMN ESYS.SYS_PROFILE.UPDATE_BY          IS '수정자';

-- PRIMARY 인덱스
ALTER TABLE ESYS.SYS_PROFILE ADD CONSTRAINT SYS_PROFILE_PK PRIMARY KEY (PROFILE_ID) USING INDEX TABLESPACE EAPEX_IDX;

-- UNIQUE 인덱스
CREATE UNIQUE INDEX ESYS.SYS_PROFILE_UK ON ESYS.SYS_PROFILE (CORP_ID, PROFILE_CD) TABLESPACE EAPEX_IDX;

-- 권한부여
GRANT SELECT, INSERT, UPDATE, DELETE ON ESYS.SYS_PROFILE TO ECOM WITH GRANT OPTION;
GRANT SELECT, INSERT, UPDATE, DELETE ON ESYS.SYS_PROFILE TO EHRM WITH GRANT OPTION;

-- 트리거 생성
CREATE OR REPLACE TRIGGER ESYS.SYS_PROFILE_TRG
    BEFORE INSERT OR UPDATE ON ESYS.SYS_PROFILE
    FOR EACH ROW
BEGIN
    IF :NEW.PROFILE_ID IS NULL THEN
        :NEW.PROFILE_ID := SYS_PROFILE_S.NEXTVAL;
    END IF;
        
    IF INSERTING THEN
        :NEW.CREATE_DATE := SYSDATE;
        :NEW.CREATE_BY   := NVL(WWV_FLOW.G_USER, USER);
    END IF;    
    
    :NEW.UPDATE_DATE := SYSDATE;
    :NEW.UPDATE_BY   := NVL(WWV_FLOW.G_USER, USER);
END;
/

-- 시노님 생성
CREATE OR REPLACE SYNONYM ECOM.SYS_PROFILE FOR ESYS.SYS_PROFILE;
CREATE OR REPLACE SYNONYM EHRM.SYS_PROFILE FOR ESYS.SYS_PROFILE;



